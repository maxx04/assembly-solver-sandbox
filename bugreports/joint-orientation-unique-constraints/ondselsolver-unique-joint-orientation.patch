@@ -0,0 +1,33 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#pragma once
+
+#include "AngleZConstraintIqcJqc.h"
+
+namespace MbD {
+    // Constraint on an AxisAngleIeqcJeqc angle (see there), e.g. the angle of J about x of I or
+    // the tilt of zJ against zI. 'spec' names the constraint in redundancy reports.
+    class AxisAngleConstraintIqcJqc : public AngleZConstraintIqcJqc
+    {
+    public:
+        AxisAngleConstraintIqcJqc(EndFrmsptr frmi, EndFrmsptr frmj, size_t cosI, size_t cosJ, size_t sinI, size_t sinJ, const char* spec);
+        static std::shared_ptr<AxisAngleConstraintIqcJqc> With(EndFrmsptr frmi, EndFrmsptr frmj, size_t cosI, size_t cosJ, size_t sinI, size_t sinJ, const char* spec);
+        // Common uses, all with target angle 0.
+        static std::shared_ptr<AxisAngleConstraintIqcJqc> AngleAboutX(EndFrmsptr frmi, EndFrmsptr frmj);
+        static std::shared_ptr<AxisAngleConstraintIqcJqc> TiltZAboutX(EndFrmsptr frmi, EndFrmsptr frmj);
+        static std::shared_ptr<AxisAngleConstraintIqcJqc> TiltZAboutY(EndFrmsptr frmi, EndFrmsptr frmj);
+
+        void initthezIeJe() override;
+        std::string constraintSpec() override;
+
+    private:
+        size_t cosAxisI, cosAxisJ, sinAxisI, sinAxisJ;
+        std::string specName;
+    };
+}
