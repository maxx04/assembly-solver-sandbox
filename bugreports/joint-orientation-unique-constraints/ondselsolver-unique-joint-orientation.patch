+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#include "AxisAngleConstraintIqcJqc.h"
+#include "AxisAngleIeqcJeqc.h"
+
+using namespace MbD;
+
+MbD::AxisAngleConstraintIqcJqc::AxisAngleConstraintIqcJqc(EndFrmsptr frmi, EndFrmsptr frmj, size_t cosI, size_t cosJ, size_t sinI, size_t sinJ, const char* spec)
+	: AngleZConstraintIqcJqc(frmi, frmj), cosAxisI(cosI), cosAxisJ(cosJ), sinAxisI(sinI), sinAxisJ(sinJ), specName(spec)
+{
+}
+
+std::shared_ptr<AxisAngleConstraintIqcJqc> MbD::AxisAngleConstraintIqcJqc::With(EndFrmsptr frmi, EndFrmsptr frmj, size_t cosI, size_t cosJ, size_t sinI, size_t sinJ, const char* spec)
+{
+	auto con = std::make_shared<AxisAngleConstraintIqcJqc>(frmi, frmj, cosI, cosJ, sinI, sinJ, spec);
+	con->initialize();
+	con->setConstant(0.0);
+	return con;
+}
+
+std::shared_ptr<AxisAngleConstraintIqcJqc> MbD::AxisAngleConstraintIqcJqc::AngleAboutX(EndFrmsptr frmi, EndFrmsptr frmj)
+{
+	return With(frmi, frmj, 1, 1, 2, 1, "AngleXConstraintIJ");
+}
+
+std::shared_ptr<AxisAngleConstraintIqcJqc> MbD::AxisAngleConstraintIqcJqc::TiltZAboutX(EndFrmsptr frmi, EndFrmsptr frmj)
+{
+	return With(frmi, frmj, 2, 2, 1, 2, "TiltZXConstraintIJ");
+}
+
+std::shared_ptr<AxisAngleConstraintIqcJqc> MbD::AxisAngleConstraintIqcJqc::TiltZAboutY(EndFrmsptr frmi, EndFrmsptr frmj)
+{
+	return With(frmi, frmj, 2, 2, 0, 2, "TiltZYConstraintIJ");
+}
+
+void MbD::AxisAngleConstraintIqcJqc::initthezIeJe()
+{
+	thezIeJe = std::make_shared<AxisAngleIeqcJeqc>(frmI, frmJ, cosAxisI, cosAxisJ, sinAxisI, sinAxisJ);
+}
+
+std::string MbD::AxisAngleConstraintIqcJqc::constraintSpec()
+{
+	return specName;
+}
diff --git a/OndselSolver/AxisAngleConstraintIqcJqc.h b/OndselSolver/AxisAngleConstraintIqcJqc.h
