+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#pragma once
+
+#include "AngleZIeqcJeqc.h"
+
+namespace MbD {
+    // Angle atan2(sin, cos) with sin = (axis sinI of I).(axis sinJ of J) and
+    // cos = (axis cosI of I).(axis cosJ of J). AngleZIeqcJeqc is cos (0,0), sin (1,0); the angle of
+    // J about x of I is cos (1,1), sin (2,1); the tilt of zJ towards yI is cos (2,2), sin (1,2).
+    // Same derivatives as AngleZIeqcJeqc, only the direction cosines differ.
+    class AxisAngleIeqcJeqc : public AngleZIeqcJeqc
+    {
+    public:
+        AxisAngleIeqcJeqc(EndFrmsptr frmi, EndFrmsptr frmj, size_t cosI, size_t cosJ, size_t sinI, size_t sinJ);
+
+        void init_aAijIeJe() override;
+
+    private:
+        size_t cosAxisI, cosAxisJ, sinAxisI, sinAxisJ;
+    };
+}
