+
+#include "AxisAngleIeqcJeqc.h"
+#include "CREATE.h"
+#include "DirectionCosineIeqcJeqc.h"
+
+using namespace MbD;
+
+MbD::AxisAngleIeqcJeqc::AxisAngleIeqcJeqc(EndFrmsptr frmi, EndFrmsptr frmj, size_t cosI, size_t cosJ, size_t sinI, size_t sinJ)
+	: AngleZIeqcJeqc(frmi, frmj), cosAxisI(cosI), cosAxisJ(cosJ), sinAxisI(sinI), sinAxisJ(sinJ)
+{
+}
+
+void MbD::AxisAngleIeqcJeqc::init_aAijIeJe()
+{
+	aA00IeJe = CREATE<DirectionCosineIeqcJeqc>::With(frmI, frmJ, cosAxisI, cosAxisJ);
+	aA10IeJe = CREATE<DirectionCosineIeqcJeqc>::With(frmI, frmJ, sinAxisI, sinAxisJ);
+}
