+std::shared_ptr<ItemIJ> MbD::ASMTTangentJoint::mbdClassNew()
+{
+	if (kind == "PointOnSurface") {
+		return CREATE<PointOnSurfaceJoint>::With();
+	}
+	if (kind == "CurveOnSurface") {
+		return CREATE<CurveOnSurfaceJoint>::With();
+	}
+	return CREATE<CurveOnCurveJoint>::With();
+}
