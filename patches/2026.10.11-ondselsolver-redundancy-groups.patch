+
+#pragma once
+
+#include "Joint.h"
+
+namespace MbD {
+	// Tangent joints besides PointOnCurveJoint. End frame I is a foot frame (EndFrameqcFoot) on
+	// the geometry of part I; its z axis is the surface normal or the curve tangent.
+
+	// Origin of end frame J on a surface: one equation (no displacement along the normal).
+	class PointOnSurfaceJoint : public Joint
+	{
+	public:
+		PointOnSurfaceJoint();
+		PointOnSurfaceJoint(const std::string& str);
+		void initializeGlobally() override;
+	};
+
+	// Curve J touches surface I from one side: the point of J with the smallest signed distance
+	// to the surface (TangentContact) lies on it. One equation; tangency and "no penetration"
+	// follow from the choice of that point.
+	class CurveOnSurfaceJoint : public Joint
+	{
+	public:
+		CurveOnSurfaceJoint();
+		CurveOnSurfaceJoint(const std::string& str);
+		void initializeGlobally() override;
+		void prePosIC() override;
+	};
+
+	// Curve J touches curve I. For a planar curve I (or J): the point of J with the smallest
+	// signed in-plane distance to I lies on I, and in its plane (two equations). Two space curves:
+	// the closest pair of points coincides (two equations).
+	class CurveOnCurveJoint : public Joint
+	{
+	public:
+		CurveOnCurveJoint();
+		CurveOnCurveJoint(const std::string& str);
+		void initializeGlobally() override;
+		void prePosIC() override;
+	};
+}
