+
+#pragma once
+
+#include "ASMTJoint.h"
+
+namespace MbD {
+	// Tangent joints besides point on curve (ASMTPointOnCurveJoint):
+	//   PointOnSurface: origin of marker J on a surface fixed to marker I,
+	//   CurveOnSurface: a curve fixed to marker J touches the surface tangentially,
+	//   CurveOnCurve:   a curve fixed to marker J touches a curve fixed to marker I tangentially.
+	// Curves and surfaces are (rational) B-splines in the coordinates of their marker.
+	class ASMTTangentJoint : public ASMTJoint
+	{
+		//
+	public:
+		struct Curve
+		{
+			size_t degree = 0;
+			std::vector<double> knots, weights, poles;  // poles: x, y, z one after the other
+			bool closed = false;
+		};
+		struct Surface
+		{
+			size_t degreeU = 0, degreeV = 0, nPolesU = 0, nPolesV = 0;
+			std::vector<double> knotsU, knotsV, weights, poles;  // row by row, i * nPolesV + j
+			bool closedU = false, closedV = false;
+		};
+
+		static std::shared_ptr<ASMTTangentJoint> With();
+		std::shared_ptr<ItemIJ> mbdClassNew() override;
+		void parseASMT(std::vector<std::string>& lines) override;
+		void createMbD(std::shared_ptr<System> mbdSys, std::shared_ptr<Units> mbdUnits) override;
+		void storeOnLevel(std::ofstream& os, size_t level) override;
+		void storeOnTimeSeries(std::ofstream& os) override;
+
+		void setPointOnSurface(const Surface& surfaceI);
+		void setCurveOnSurface(const Surface& surfaceI, const Curve& curveJ);
+		void setCurveOnCurve(const Curve& curveI, const Curve& curveJ);
+
+		std::string kind;  // "PointOnSurface", "CurveOnSurface" or "CurveOnCurve"
+		Curve curveI, curveJ;
+		Surface surfaceI;
+	};
+}
