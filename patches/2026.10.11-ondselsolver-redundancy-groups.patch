+namespace {
+// FCPROJECT-PATCH (2026-10-11): OndselSolver meldet nur, WELCHE Gleichung linear abhaengig ist -
+// welche das ist, haengt von der Pivotreihenfolge ab und trifft oft ein unbeteiligtes Gelenk
+// (live an BG22: eine Parallel-Verbindung ueberbestimmte die Drehung um eine Gewindestange, gemeldet
+// wurde ein Gelenk einer anderen Fuehrungsbaugruppe). Hier wird die entnommene Zeile als
+// Linearkombination der uebrigen Constraint-Zeilen der Jacobi-Matrix dargestellt (kleinste
+// Quadrate ueber die Normalgleichungen); alle Zeilen mit nennenswertem Koeffizienten bilden
+// zusammen mit ihr die ueberbestimmte Gruppe. Laeuft nur, wenn eine Redundanz gefunden wurde.
+using SparseRowCopy = std::map<size_t, double>;
+
+double dotRows(const SparseRowCopy& a, const SparseRowCopy& b)
+{
+	const SparseRowCopy& small = a.size() <= b.size() ? a : b;
+	const SparseRowCopy& large = a.size() <= b.size() ? b : a;
+	double sum = 0.0;
+	for (const auto& [col, value] : small) {
+		auto it = large.find(col);
+		if (it != large.end()) {
+			sum += value * it->second;
+		}
+	}
+	return sum;
+}
+
+// Loest (M + eps*I) c = b mit Gauss-Elimination und Spaltenpivot; M symmetrisch positiv
+// semidefinit.
+std::vector<double> solveDense(std::vector<std::vector<double>> M, std::vector<double> b)
+{
+	const size_t k = b.size();
+	for (size_t i = 0; i < k; ++i) {
+		M[i][i] += 1.0e-12 * (M[i][i] + 1.0);
+	}
+	for (size_t p = 0; p < k; ++p) {
+		size_t pivot = p;
+		for (size_t i = p + 1; i < k; ++i) {
+			if (std::abs(M[i][p]) > std::abs(M[pivot][p])) {
+				pivot = i;
+			}
+		}
+		std::swap(M[p], M[pivot]);
+		std::swap(b[p], b[pivot]);
+		if (std::abs(M[p][p]) < 1.0e-300) {
+			continue;
+		}
+		for (size_t i = p + 1; i < k; ++i) {
+			const double f = M[i][p] / M[p][p];
+			if (f == 0.0) {
+				continue;
+			}
+			for (size_t j = p; j < k; ++j) {
+				M[i][j] -= f * M[p][j];
+			}
+			b[i] -= f * b[p];
+		}
+	}
+	std::vector<double> c(k, 0.0);
+	for (size_t i = k; i-- > 0;) {
+		double sum = b[i];
+		for (size_t j = i + 1; j < k; ++j) {
+			sum -= M[i][j] * c[j];
+		}
+		c[i] = std::abs(M[i][i]) < 1.0e-300 ? 0.0 : sum / M[i][i];
+	}
+	return c;
+}
