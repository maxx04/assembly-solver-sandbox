@@ -0,0 +1,336 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#include <algorithm>
+#include <cmath>
+
+#include "NurbsSurface.h"
+
+using namespace MbD;
+
+namespace {
+	using Vec3 = MbD::NurbsSurface::Vec3;
+
+	double dot(const Vec3& a, const Vec3& b)
+	{
+		return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+	}
+
+	Vec3 minus(const Vec3& a, const Vec3& b)
+	{
+		return { a[0] - b[0], a[1] - b[1], a[2] - b[2] };
+	}
+
+	double dist2(const Vec3& a, const Vec3& b)
+	{
+		auto d = minus(a, b);
+		return dot(d, d);
+	}
+
+	double wrapOrClamp(double u, double a, double b, bool closed)
+	{
+		if (closed) {
+			double period = b - a;
+			u = a + std::fmod(u - a, period);
+			if (u < a) {
+				u += period;
+			}
+			return u;
+		}
+		return std::clamp(u, a, b);
+	}
+}
+
+size_t MbD::nurbsFindSpan(const std::vector<double>& knots, size_t degree, size_t nPoles, double u)
+{
+	size_t n = nPoles - 1;
+	if (u >= knots[n + 1]) {
+		return n;
+	}
+	if (u <= knots[degree]) {
+		return degree;
+	}
+	size_t low = degree;
+	size_t high = n + 1;
+	size_t mid = (low + high) / 2;
+	while (u < knots[mid] || u >= knots[mid + 1]) {
+		if (u < knots[mid]) {
+			high = mid;
+		}
+		else {
+			low = mid;
+		}
+		mid = (low + high) / 2;
+	}
+	return mid;
+}
+
+void MbD::nurbsDersBasisFuns(const std::vector<double>& knots, size_t degree, size_t span,
+	double u, size_t nDerivs, std::vector<std::vector<double>>& ders)
+{
+	size_t p = degree;
+	std::vector<std::vector<double>> ndu(p + 1, std::vector<double>(p + 1, 0.0));
+	std::vector<double> left(p + 1, 0.0), right(p + 1, 0.0);
+	ndu[0][0] = 1.0;
+	for (size_t j = 1; j <= p; j++) {
+		left[j] = u - knots[span + 1 - j];
+		right[j] = knots[span + j] - u;
+		double saved = 0.0;
+		for (size_t r = 0; r < j; r++) {
+			ndu[j][r] = right[r + 1] + left[j - r];
+			double temp = ndu[r][j - 1] / ndu[j][r];
+			ndu[r][j] = saved + right[r + 1] * temp;
+			saved = left[j - r] * temp;
+		}
+		ndu[j][j] = saved;
+	}
+	ders.assign(nDerivs + 1, std::vector<double>(p + 1, 0.0));
+	for (size_t j = 0; j <= p; j++) {
+		ders[0][j] = ndu[j][p];
+	}
+	std::vector<std::vector<double>> a(2, std::vector<double>(p + 1, 0.0));
+	for (int r = 0; r <= (int)p; r++) {
+		int s1 = 0;
+		int s2 = 1;
+		a[0][0] = 1.0;
+		for (int k = 1; k <= (int)nDerivs; k++) {
+			double d = 0.0;
+			int rk = r - k;
+			int pk = (int)p - k;
+			if (r >= k) {
+				a[s2][0] = a[s1][0] / ndu[pk + 1][rk];
+				d = a[s2][0] * ndu[rk][pk];
+			}
+			int j1 = (rk >= -1) ? 1 : -rk;
+			int j2 = (r - 1 <= pk) ? k - 1 : (int)p - r;
+			for (int j = j1; j <= j2; j++) {
+				a[s2][j] = (a[s1][j] - a[s1][j - 1]) / ndu[pk + 1][rk + j];
+				d += a[s2][j] * ndu[rk + j][pk];
+			}
+			if (r <= pk) {
+				a[s2][k] = -a[s1][k - 1] / ndu[pk + 1][r];
+				d += a[s2][k] * ndu[r][pk];
+			}
+			ders[k][r] = d;
+			std::swap(s1, s2);
+		}
+	}
+	double factor = (double)p;
+	for (size_t k = 1; k <= nDerivs; k++) {
+		for (size_t j = 0; j <= p; j++) {
+			ders[k][j] *= factor;
+		}
+		factor *= (double)(p - k);
+	}
+}
+
+MbD::NurbsSurface::NurbsSurface(size_t degU, size_t degV, std::vector<double> kU,
+	std::vector<double> kV, size_t nU, size_t nV, std::vector<double> wts, std::vector<Vec3> pls,
+	bool isClosedU, bool isClosedV) :
+	degreeU(degU), degreeV(degV), nPolesU(nU), nPolesV(nV), knotsU(std::move(kU)),
+	knotsV(std::move(kV)), weights(std::move(wts)), poles(std::move(pls)), closedU(isClosedU),
+	closedV(isClosedV)
+{
+	if (weights.empty()) {
+		weights.assign(poles.size(), 1.0);
+	}
+}
+
+bool MbD::NurbsSurface::isValid() const
+{
+	return degreeU >= 1 && degreeV >= 1 && nPolesU > degreeU && nPolesV > degreeV
+		&& poles.size() == nPolesU * nPolesV && weights.size() == poles.size()
+		&& knotsU.size() == nPolesU + degreeU + 1 && knotsV.size() == nPolesV + degreeV + 1
+		&& lastU() > firstU() && lastV() > firstV();
+}
+
+double MbD::NurbsSurface::firstU() const
+{
+	return knotsU[degreeU];
+}
+
+double MbD::NurbsSurface::lastU() const
+{
+	return knotsU[nPolesU];
+}
+
+double MbD::NurbsSurface::firstV() const
+{
+	return knotsV[degreeV];
+}
+
+double MbD::NurbsSurface::lastV() const
+{
+	return knotsV[nPolesV];
+}
+
+double MbD::NurbsSurface::normalizeU(double u) const
+{
+	return wrapOrClamp(u, firstU(), lastU(), closedU);
+}
+
+double MbD::NurbsSurface::normalizeV(double v) const
+{
+	return wrapOrClamp(v, firstV(), lastV(), closedV);
+}
+
+void MbD::NurbsSurface::evaluate(double u, double v, Vec3& s, Vec3& su, Vec3& sv, Vec3& suu,
+	Vec3& suv, Vec3& svv) const
+{
+	u = normalizeU(u);
+	v = normalizeV(v);
+	size_t spanU = nurbsFindSpan(knotsU, degreeU, nPolesU, u);
+	size_t spanV = nurbsFindSpan(knotsV, degreeV, nPolesV, v);
+	size_t nDu = std::min<size_t>(2, degreeU);
+	size_t nDv = std::min<size_t>(2, degreeV);
+	std::vector<std::vector<double>> nu, nv;
+	nurbsDersBasisFuns(knotsU, degreeU, spanU, u, nDu, nu);
+	nurbsDersBasisFuns(knotsV, degreeV, spanV, v, nDv, nv);
+	// Homogeneous derivatives A(k,l) = sum Nu(k) Nv(l) w P and w(k,l), k + l <= 2.
+	Vec3 a[3][3] = {};
+	double w[3][3] = {};
+	for (size_t k = 0; k <= nDu; k++) {
+		for (size_t l = 0; l <= nDv && k + l <= 2; l++) {
+			for (size_t i = 0; i <= degreeU; i++) {
+				size_t iu = spanU - degreeU + i;
+				for (size_t j = 0; j <= degreeV; j++) {
+					size_t jv = spanV - degreeV + j;
+					size_t idx = iu * nPolesV + jv;
+					double nw = nu[k][i] * nv[l][j] * weights[idx];
+					for (size_t m = 0; m < 3; m++) {
+						a[k][l][m] += nw * poles[idx][m];
+					}
+					w[k][l] += nw;
+				}
+			}
+		}
+	}
+	// Rational derivatives (The NURBS Book, A4.4).
+	for (size_t m = 0; m < 3; m++) {
+		s[m] = a[0][0][m] / w[0][0];
+		su[m] = (a[1][0][m] - w[1][0] * s[m]) / w[0][0];
+		sv[m] = (a[0][1][m] - w[0][1] * s[m]) / w[0][0];
+		suu[m] = (a[2][0][m] - 2.0 * w[1][0] * su[m] - w[2][0] * s[m]) / w[0][0];
+		svv[m] = (a[0][2][m] - 2.0 * w[0][1] * sv[m] - w[0][2] * s[m]) / w[0][0];
+		suv[m] = (a[1][1][m] - w[1][0] * sv[m] - w[0][1] * su[m] - w[1][1] * s[m]) / w[0][0];
+	}
+}
+
+NurbsSurface::Vec3 MbD::NurbsSurface::value(double u, double v) const
+{
+	Vec3 s, su, sv, suu, suv, svv;
+	evaluate(u, v, s, su, sv, suu, suv, svv);
+	return s;
+}
+
+NurbsSurface::Vec3 MbD::NurbsSurface::normal(double u, double v) const
+{
+	Vec3 s, su, sv, suu, suv, svv;
+	evaluate(u, v, s, su, sv, suu, suv, svv);
+	Vec3 n = { su[1] * sv[2] - su[2] * sv[1], su[2] * sv[0] - su[0] * sv[2], su[0] * sv[1] - su[1] * sv[0] };
+	double len = std::sqrt(dot(n, n));
+	if (len > 0.0) {
+		for (auto& x : n) {
+			x /= len;
+		}
+	}
+	return n;
+}
+
+void MbD::NurbsSurface::sampleStart(const Vec3& p, double& u, double& v) const
+{
+	size_t nu = std::clamp<size_t>(4 * nPolesU, 20, 60);
+	size_t nv = std::clamp<size_t>(4 * nPolesV, 20, 60);
+	double best = std::numeric_limits<double>::max();
+	for (size_t i = 0; i <= nu; i++) {
+		double ui = firstU() + (lastU() - firstU()) * (double)i / (double)nu;
+		for (size_t j = 0; j <= nv; j++) {
+			double vj = firstV() + (lastV() - firstV()) * (double)j / (double)nv;
+			double d = dist2(value(ui, vj), p);
+			if (d < best) {
+				best = d;
+				u = ui;
+				v = vj;
+			}
+		}
+	}
+}
+
+void MbD::NurbsSurface::project(const Vec3& p, double& u, double& v) const
+{
+	if (std::isnan(u) || std::isnan(v)) {
+		sampleStart(p, u, v);
+	}
+	u = normalizeU(u);
+	v = normalizeV(v);
+	double rangeU = lastU() - firstU();
+	double rangeV = lastV() - firstV();
+	// Newton on grad 0.5 |S - p|^2 = 0, Gauss-Newton when the Hessian is not positive definite,
+	// damped so that the distance never grows.
+	Vec3 s, su, sv, suu, suv, svv;
+	evaluate(u, v, s, su, sv, suu, suv, svv);
+	double current = dist2(s, p);
+	for (int iter = 0; iter < 50; iter++) {
+		auto r = minus(s, p);
+		double gu = dot(r, su);
+		double gv = dot(r, sv);
+		double huu = dot(su, su) + dot(r, suu);
+		double huv = dot(su, sv) + dot(r, suv);
+		double hvv = dot(sv, sv) + dot(r, svv);
+		double det = huu * hvv - huv * huv;
+		if (huu <= 0.0 || det <= 1.0e-300 * (std::fabs(huu * hvv) + 1.0)) {
+			huu = dot(su, su);
+			huv = dot(su, sv);
+			hvv = dot(sv, sv);
+			det = huu * hvv - huv * huv;
+		}
+		if (det <= 0.0) {
+			break;
+		}
+		double du = -(hvv * gu - huv * gv) / det;
+		double dv = -(huu * gv - huv * gu) / det;
+		du = std::clamp(du, -0.25 * rangeU, 0.25 * rangeU);
+		dv = std::clamp(dv, -0.25 * rangeV, 0.25 * rangeV);
+		bool improved = false;
+		for (int halving = 0; halving < 20; halving++) {
+			double uNew = normalizeU(u + du);
+			double vNew = normalizeV(v + dv);
+			Vec3 sN, suN, svN, suuN, suvN, svvN;
+			evaluate(uNew, vNew, sN, suN, svN, suuN, suvN, svvN);
+			double dN = dist2(sN, p);
+			if (dN <= current) {
+				double moved = std::fabs(uNew - u) / rangeU + std::fabs(vNew - v) / rangeV;
+				u = uNew;
+				v = vNew;
+				s = sN;
+				su = suN;
+				sv = svN;
+				suu = suuN;
+				suv = suvN;
+				svv = svvN;
+				current = dN;
+				improved = moved > 1.0e-15;
+				break;
+			}
+			du *= 0.5;
+			dv *= 0.5;
+		}
+		if (!improved) {
+			break;
+		}
+	}
+}
+
+void MbD::NurbsSurface::scale(double factor)
+{
+	for (auto& p : poles) {
+		for (auto& x : p) {
+			x *= factor;
+		}
+	}
+}
