+#pragma once
+
+#include <memory>
+
+#include "EndFrameqcOffset.h"
+#include "NurbsCurve.h"
+
+namespace MbD {
+	class TangentContact;
+
+	// End frame that sits on a foot point of a curve or surface fixed to its marker and is moved
+	// there in every iteration (Tangent joints). Its z axis is the curve tangent or the surface
+	// normal. Without a contact the foot point is the one closest to end frame J of the joint;
+	// with a contact (curve on curve, curve on surface) the contact places both frames on the
+	// closest pair of points.
+	class EndFrameqcFoot : public EndFrameqcOffset
+	{
+		//refX contact
+	public:
+		using Vec3 = NurbsCurve::Vec3;
+		EndFrameqcFoot();
+		EndFrameqcFoot(const std::string& str);
+		// rOpO: a point (global coordinates). Moves this frame to the foot point closest to it.
+		virtual void updateFootPoint(FColDsptr rOpO) = 0;
+		// Forgets the last foot point, the next search starts from a sampling.
+		virtual void resetFootPoint() = 0;
+		// Called by the constraint functions before they evaluate.
+		void updateFor(EndFrmsptr frmJ);
+		// Point in the coordinates of this frame's marker, and back.
+		FColDsptr pointInMarker(FColDsptr rOpO);
+		FColDsptr pointInGlobal(const Vec3& rmpm);
+		// Origin and z axis in marker coordinates; x stays as close as possible to the last x so
+		// the frame does not spin around z between iterations.
+		void setFoot(const Vec3& origin, const Vec3& zAxis);
+		// Origin and both x and z axis given (z is normalized, x made perpendicular to it).
+		void setFootFrame(const Vec3& origin, const Vec3& xAxis, const Vec3& zAxis);
+		std::shared_ptr<TangentContact> contact;
+		Vec3 refX = { 0.0, 0.0, 0.0 };
+	};
+}
