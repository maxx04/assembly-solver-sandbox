+
+using namespace MbD;
+
+DispCompIeqcJeqcKeqcCurve::DispCompIeqcJeqcKeqcCurve(EndFrmsptr frmi, EndFrmsptr frmj, EndFrmsptr frmk, size_t axisk) :
+	DispCompIeqcJeqcKeqc(frmi, frmj, frmk, axisk)
+{
+}
+
+void DispCompIeqcJeqcKeqcCurve::calcPostDynCorrectorIteration()
+{
+	// Parts (and with them all marker and end frames) are updated before joints, so frmJ
+	// already holds the position of this iteration.
+	if (auto footFrm = std::dynamic_pointer_cast<EndFrameqcFoot>(efrmK)) {
+		footFrm->updateFor(frmJ);
+	}
+	DispCompIeqcJeqcKeqc::calcPostDynCorrectorIteration();
+}
+
+PointOnCurveConstraintIqcJqc::PointOnCurveConstraintIqcJqc(EndFrmsptr frmi, EndFrmsptr frmj, size_t axisi) :
+	TranslationConstraintIqcJqc(frmi, frmj, axisi)
+{
+}
+
+void PointOnCurveConstraintIqcJqc::initriIeJeIe()
+{
+	riIeJeIe = CREATE<DispCompIeqcJeqcKeqcCurve>::With(frmI, frmJ, frmI, axisI);
+}
+
+std::string PointOnCurveConstraintIqcJqc::constraintSpec()
+{
+	return "PointOnCurveConstraintI" + MbDMath::xyzFromInt(axisI) + "J";
+}
+
+void PointOnCurveConstraintIqcJqc::fillPosICJacob(SpMatDsptr mat)
+{
+	TranslationConstraintIqcJqc::fillPosICJacob(mat);
+	auto footI = std::dynamic_pointer_cast<EndFrameqcFoot>(frmI);
+	if (!footI || !footI->contact || footI->contact->distanceAxis() != axisI) {
+		return;
+	}
+	auto& contact = footI->contact;
+	double speed = 0.0;
+	double ftt = 0.0;
+	bool envelope = contact->envelopeTerms(speed, ftt);
+	std::array<double, 9> hessian;
+	bool curvature = contact->distanceHessian(hessian);
+	if (!envelope && !curvature) {
+		return;
+	}
+	auto efrmI = std::static_pointer_cast<EndFrameqc>(frmI);
+	auto efrmJ = std::static_pointer_cast<EndFrameqc>(frmJ);
+	using Vec3 = std::array<double, 3>;
+	auto column = [](const FMatDsptr& m, size_t k) {
+		return Vec3 { m->at(0)->at(k), m->at(1)->at(k), m->at(2)->at(k) };
+	};
+	auto dot3 = [](const Vec3& a, const Vec3& b) {
+		return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+	};
+	Vec3 n = column(efrmI->aAOe, axisI);   // oriented distance direction, global
+	Vec3 tJ = column(efrmJ->aAOe, 2);      // unit tangent of J at the contact, global
+	// Blocks XI, EI, XJ, EJ: derivatives of the relative contact position r = xJ - xI (the
+	// contact point lies on I's foot, the origin of frame I) and of df/dt.
+	const size_t sizes[4] = { 3, 4, 3, 4 };
+	const size_t starts[4] = { iqXI, iqEI, iqXJ, iqEJ };
+	std::vector<Vec3> jr[4];
+	std::vector<double> g[4];
+	for (size_t k = 0; k < 3; k++) {
+		Vec3 e = { 0.0, 0.0, 0.0 };
+		e[k] = 1.0;
+		jr[2].push_back(e);
+		e[k] = -1.0;
+		jr[0].push_back(e);
+	}
+	for (size_t k = 0; k < 4; k++) {
+		Vec3 pI = column(efrmI->prOeOpE, k);
+		for (auto& x : pI) {
+			x = -x;
+		}
+		jr[1].push_back(pI);
+		jr[3].push_back(column(efrmJ->prOeOpE, k));
+	}
+	// df/dt = speed * n . tJ (+ curvature of I: d(grad D . x')/dq = (H x')^T dr/dq).
+	Vec3 hx = { 0.0, 0.0, 0.0 };
+	if (curvature) {
+		for (size_t r = 0; r < 3; r++) {
+			for (size_t k = 0; k < 3; k++) {
+				hx[r] += hessian[3 * r + k] * speed * tJ[k];
+			}
+		}
+	}
+	for (size_t b = 0; b < 4; b++) {
+		g[b].assign(sizes[b], 0.0);
+		for (size_t k = 0; k < sizes[b]; k++) {
+			if (curvature) {
+				g[b][k] += dot3(hx, jr[b][k]);
+			}
+		}
+	}
+	if (envelope && curvature) {
+		// Exact f_tt = n . x'' + x'^T H x' instead of the finite difference: the multiplier can
+		// be large, and the terms here nearly cancel the frozen ones.
+		ftt = contact->secondDerivativeAlongJ(n) + speed * dot3(tJ, hx);
+		envelope = ftt > 1.0e-9 * speed * speed;
+	}
+	for (size_t k = 0; k < 4; k++) {
+		g[1][k] += speed * dot3(column(efrmI->pAOepE->at(k), axisI), tJ);
+		g[3][k] += speed * dot3(n, column(efrmJ->pAOepE->at(k), 2));
+	}
+	// lam * (dr/dq^T H dr/dq - g g^T / f_tt), added on top of the frozen second derivatives,
+	// weighted by closeness to contact.
+	double weight = contact->exactSecondDerivativeWeight();
+	if (weight < 1.0e-6) {
+		return;
+	}
+	for (size_t b1 = 0; b1 < 4; b1++) {
+		for (size_t b2 = 0; b2 < 4; b2++) {
+			auto m = std::make_shared<FullMatrix<double>>(sizes[b1], sizes[b2]);
+			for (size_t i = 0; i < sizes[b1]; i++) {
+				Vec3 hi = { 0.0, 0.0, 0.0 };
+				if (curvature) {
+					for (size_t r = 0; r < 3; r++) {
+						for (size_t k = 0; k < 3; k++) {
+							hi[r] += jr[b1][i][k] * hessian[3 * k + r];
+						}
+					}
+				}
+				for (size_t j = 0; j < sizes[b2]; j++) {
+					double value = curvature ? dot3(hi, jr[b2][j]) : 0.0;
+					if (envelope) {
+						value -= g[b1][i] * g[b2][j] / ftt;
+					}
+					m->at(i)->at(j) = weight * lam * value;
+				}
+			}
+			mat->atijplusFullMatrix(starts[b1], starts[b2], m);
+		}
+	}
+}
