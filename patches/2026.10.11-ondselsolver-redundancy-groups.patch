+namespace {
+	void storeDoubles(std::ofstream& os, size_t level, const std::vector<double>& values)
+	{
+		for (size_t i = 0; i < level; i++) {
+			os << '\t';
+		}
+		auto oldPrecision = os.precision(std::numeric_limits<double>::max_digits10);
+		for (double value : values) {
+			os << value << '\t';
+		}
+		os << std::endl;
+		os.precision(oldPrecision);
+	}
+
+	std::vector<NurbsCurve::Vec3> toVec3(const std::vector<double>& flat)
+	{
+		std::vector<NurbsCurve::Vec3> out;
+		for (size_t i = 0; i + 2 < flat.size(); i += 3) {
+			out.push_back({ flat[i], flat[i + 1], flat[i + 2] });
+		}
+		return out;
+	}
+
+	std::shared_ptr<NurbsCurve> makeCurve(const ASMTTangentJoint::Curve& c, double lengthUnit,
+		const std::string& jointName)
+	{
+		auto curve = std::make_shared<NurbsCurve>(c.degree, c.knots, c.weights, toVec3(c.poles), c.closed);
+		if (!curve->isValid()) {
+			throw SimulationStoppingError("TangentJoint " + jointName + ": invalid curve.");
+		}
+		curve->scale(1.0 / lengthUnit);
+		return curve;
+	}
+
+	std::shared_ptr<NurbsSurface> makeSurface(const ASMTTangentJoint::Surface& s, double lengthUnit,
+		const std::string& jointName)
+	{
+		auto surface = std::make_shared<NurbsSurface>(s.degreeU, s.degreeV, s.knotsU, s.knotsV,
+			s.nPolesU, s.nPolesV, s.weights, toVec3(s.poles), s.closedU, s.closedV);
+		if (!surface->isValid()) {
+			throw SimulationStoppingError("TangentJoint " + jointName + ": invalid surface.");
+		}
+		surface->scale(1.0 / lengthUnit);
+		return surface;
+	}
+}
+
+std::shared_ptr<ASMTTangentJoint> MbD::ASMTTangentJoint::With()
+{
+	auto asmt = std::make_shared<ASMTTangentJoint>();
+	asmt->initialize();
+	return asmt;
+}
