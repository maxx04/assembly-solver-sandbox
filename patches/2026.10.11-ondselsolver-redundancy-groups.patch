+namespace {
+	// Unit vectors x, y perpendicular to z, columns of aAme = [x y z].
+	void setFrameAlong(FMatDsptr aAme, const NurbsCurve::Vec3& z)
+	{
+		size_t k = 0;
+		for (size_t i = 1; i < 3; i++) {
+			if (std::fabs(z[i]) < std::fabs(z[k])) {
+				k = i;
+			}
+		}
+		NurbsCurve::Vec3 x = { 0.0, 0.0, 0.0 };
+		x[k] = 1.0;
+		double along = x[0] * z[0] + x[1] * z[1] + x[2] * z[2];
+		for (size_t i = 0; i < 3; i++) {
+			x[i] -= along * z[i];
+		}
+		double len = std::sqrt(x[0] * x[0] + x[1] * x[1] + x[2] * x[2]);
+		for (auto& xi : x) {
+			xi /= len;
+		}
+		NurbsCurve::Vec3 y = { z[1] * x[2] - z[2] * x[1], z[2] * x[0] - z[0] * x[2], z[0] * x[1] - z[1] * x[0] };
+		for (size_t i = 0; i < 3; i++) {
+			aAme->at(i)->at(0) = x[i];
+			aAme->at(i)->at(1) = y[i];
+			aAme->at(i)->at(2) = z[i];
+		}
+	}
+
+	void storeOnLevelDoubles(std::ofstream& os, size_t level, const std::vector<double>& values)
+	{
+		for (size_t i = 0; i < level; i++) {
+			os << '\t';
+		}
+		auto oldPrecision = os.precision(std::numeric_limits<double>::max_digits10);
+		for (double value : values) {
+			os << value << '\t';
+		}
+		os << std::endl;
+		os.precision(oldPrecision);
+	}
+}
