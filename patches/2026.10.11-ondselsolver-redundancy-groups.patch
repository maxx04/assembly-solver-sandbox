diff --git a/src/3rdParty/OndselSolver/OndselSolver/TangentContact.cpp b/src/3rdParty/OndselSolver/OndselSolver/TangentContact.cpp
new file mode 100644
index 0000000..c1a7714
--- /dev/null
+++ b/src/3rdParty/OndselSolver/OndselSolver/TangentContact.cpp
@@ -0,0 +1,537 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include "TangentContact.h"
+#include "EndFrameqcCurve.h"
+#include "EndFrameqcSurface.h"
+#include "MarkerFrame.h"
+
+using namespace MbD;
+
+namespace {
+	using Vec3 = MbD::NurbsCurve::Vec3;
+
+	double dot(const Vec3& a, const Vec3& b)
+	{
+		return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+	}
+
+	Vec3 minus(const Vec3& a, const Vec3& b)
+	{
+		return { a[0] - b[0], a[1] - b[1], a[2] - b[2] };
+	}
+
+	Vec3 cross(const Vec3& a, const Vec3& b)
+	{
+		return { a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0] };
+	}
+
+	bool normalize(Vec3& a)
+	{
+		double len = std::sqrt(dot(a, a));
+		if (len < 1.0e-300) {
+			return false;
+		}
+		for (auto& x : a) {
+			x /= len;
+		}
+		return true;
+	}
+
+	Vec3 toVec3(FColDsptr col)
+	{
+		return { col->at(0), col->at(1), col->at(2) };
+	}
+
+	// Normal of the plane of a planar pole polygon (Newell), false if the poles are not planar
+	// or all on a line.
+	bool planeNormal(const std::vector<Vec3>& poles, Vec3& normal)
+	{
+		if (poles.size() < 3) {
+			return false;
+		}
+		Vec3 n = { 0.0, 0.0, 0.0 };
+		Vec3 centroid = { 0.0, 0.0, 0.0 };
+		for (size_t i = 0; i < poles.size(); i++) {
+			const auto& a = poles[i];
+			const auto& b = poles[(i + 1) % poles.size()];
+			n[0] += (a[1] - b[1]) * (a[2] + b[2]);
+			n[1] += (a[2] - b[2]) * (a[0] + b[0]);
+			n[2] += (a[0] - b[0]) * (a[1] + b[1]);
+			for (size_t k = 0; k < 3; k++) {
+				centroid[k] += a[k] / (double)poles.size();
+			}
+		}
+		double extent = 0.0;
+		for (const auto& p : poles) {
+			auto d = minus(p, centroid);
+			extent = std::max(extent, std::sqrt(dot(d, d)));
+		}
+		if (extent <= 0.0 || std::sqrt(dot(n, n)) < 1.0e-9 * extent * extent || !normalize(n)) {
+			return false;
+		}
+		for (const auto& p : poles) {
+			if (std::fabs(dot(minus(p, centroid), n)) > 1.0e-6 * extent) {
+				return false;
+			}
+		}
+		normal = n;
+		return true;
+	}
+}
+
+void TangentContact::initialize()
+{
+	initialized = true;
+	planar = false;
+	if (auto curveFrm = dynamic_cast<EndFrameqcCurve*>(frmI)) {
+		if (curveFrm->curve && planeNormal(curveFrm->curve->poles, planeNormalI)) {
+			planar = true;
+		}
+		else if (frmJ->curve) {
+			// Curve I straight or spatial: use the plane of curve J if it has one.
+			Vec3 nJ;
+			if (planeNormal(frmJ->curve->poles, nJ)) {
+				auto origin = frmJ->pointInGlobal({ 0.0, 0.0, 0.0 });
+				auto tip = frmJ->pointInGlobal(nJ);
+				auto originI = toVec3(frmI->pointInMarker(origin));
+				auto tipI = toVec3(frmI->pointInMarker(tip));
+				planeNormalI = minus(tipI, originI);
+				planar = normalize(planeNormalI);
+			}
+		}
+	}
+	// Coarse search over curve J, unoriented distances; side = where most of J lies.
+	auto& curveJ = *frmJ->curve;
+	{
+		Vec3 lo = curveJ.poles.front();
+		Vec3 hi = lo;
+		for (const auto& p : curveJ.poles) {
+			for (size_t k = 0; k < 3; k++) {
+				lo[k] = std::min(lo[k], p[k]);
+				hi[k] = std::max(hi[k], p[k]);
+			}
+		}
+		auto diag = minus(hi, lo);
+		sizeJ = std::sqrt(dot(diag, diag));
+	}
+	const size_t nSamples = 96;
+	std::vector<double> ts, values;
+	for (size_t i = 0; i <= nSamples; i++) {
+		double ti = curveJ.firstParameter()
+			+ (curveJ.lastParameter() - curveJ.firstParameter()) * (double)i / (double)nSamples;
+		uI = std::numeric_limits<double>::quiet_NaN();
+		vI = std::numeric_limits<double>::quiet_NaN();
+		side = 1.0;
+		ts.push_back(ti);
+		values.push_back(signedDistance(ti, nullptr));
+	}
+	bool isSurface = dynamic_cast<EndFrameqcSurface*>(frmI) != nullptr;
+	if (isSurface || planar) {
+		auto sorted = values;
+		std::nth_element(sorted.begin(), sorted.begin() + sorted.size() / 2, sorted.end());
+		side = sorted[sorted.size() / 2] >= 0.0 ? 1.0 : -1.0;
+	}
+	size_t best = 0;
+	for (size_t i = 1; i < values.size(); i++) {
+		if (side * values[i] < side * values[best]) {
+			best = i;
+		}
+	}
+	double width = (curveJ.lastParameter() - curveJ.firstParameter()) / (double)nSamples;
+	uI = std::numeric_limits<double>::quiet_NaN();
+	vI = std::numeric_limits<double>::quiet_NaN();
+	t = minimizeAround(ts[best], width);
+}
+
+double TangentContact::signedDistance(double tt, Foot* foot)
+{
+	auto& curveJ = *frmJ->curve;
+	auto pJ = frmJ->pointInGlobal(curveJ.value(tt));
+	Vec3 p = toVec3(frmI->pointInMarker(pJ));
+	if (auto surfaceFrm = dynamic_cast<EndFrameqcSurface*>(frmI)) {
+		auto& surface = *surfaceFrm->surface;
+		surface.project(p, uI, vI);
+		Vec3 s = surface.value(uI, vI);
+		Vec3 n = surface.normal(uI, vI);
+		for (auto& x : n) {
+			x *= side;
+		}
+		if (foot) {
+			foot->point = s;
+			foot->normal = n;
+		}
+		return dot(minus(p, s), n);
+	}
+	auto curveFrm = dynamic_cast<EndFrameqcCurve*>(frmI);
+	auto& curveI = *curveFrm->curve;
+	uI = curveI.project(p, uI);
+	Vec3 c, d1, d2;
+	curveI.evaluate(uI, c, d1, d2);
+	Vec3 tangent = d1;
+	normalize(tangent);
+	auto d = minus(p, c);
+	if (!planar) {
+		if (foot) {
+			foot->point = c;
+			foot->tangent = tangent;
+		}
+		return std::sqrt(dot(d, d));
+	}
+	Vec3 inPlane = cross(planeNormalI, tangent);
+	normalize(inPlane);
+	for (auto& x : inPlane) {
+		x *= side;
+	}
+	if (foot) {
+		foot->point = c;
+		foot->normal = inPlane;
+		foot->tangent = tangent;
+	}
+	return dot(d, inPlane);
+}
+
+double TangentContact::minimizeAround(double t0, double halfWidth)
+{
+	auto& curveJ = *frmJ->curve;
+	double a0 = curveJ.firstParameter();
+	double b0 = curveJ.lastParameter();
+	bool closed = curveJ.isClosed();
+	auto value = [&](double tt) {
+		return signedDistance(curveJ.normalizeParameter(tt), nullptr);
+	};
+	double center = t0;
+	for (int shift = 0; shift < 16; shift++) {
+		double lo = center - halfWidth;
+		double hi = center + halfWidth;
+		if (!closed) {
+			lo = std::max(lo, a0);
+			hi = std::min(hi, b0);
+		}
+		// Golden-section search.
+		const double g = (std::sqrt(5.0) - 1.0) / 2.0;
+		double x1 = hi - g * (hi - lo);
+		double x2 = lo + g * (hi - lo);
+		double f1 = value(x1);
+		double f2 = value(x2);
+		for (int i = 0; i < 80 && hi - lo > 1.0e-14 * (b0 - a0); i++) {
+			if (f1 < f2) {
+				hi = x2;
+				x2 = x1;
+				f2 = f1;
+				x1 = hi - g * (hi - lo);
+				f1 = value(x1);
+			}
+			else {
+				lo = x1;
+				x1 = x2;
+				f1 = f2;
+				x2 = lo + g * (hi - lo);
+				f2 = value(x2);
+			}
+		}
+		double tMin = 0.5 * (lo + hi);
+		// At the edge of the window (and not at an open curve end): move the window on.
+		double edgeTol = 1.0e-6 * halfWidth;
+		bool atLow = tMin - (center - halfWidth) < edgeTol && (closed || tMin - a0 > edgeTol);
+		bool atHigh = (center + halfWidth) - tMin < edgeTol && (closed || b0 - tMin > edgeTol);
+		if (!atLow && !atHigh) {
+			return refineMinimum(curveJ.normalizeParameter(tMin));
+		}
+		center = tMin;
+	}
+	return curveJ.normalizeParameter(center);
+}
+
+void TangentContact::update()
+{
+	if (!frmI || !frmJ || !frmJ->curve) {
+		return;
+	}
+	if (!initialized || std::isnan(t)) {
+		initialize();
+	}
+	else {
+		auto& curveJ = *frmJ->curve;
+		t = minimizeAround(t, (curveJ.lastParameter() - curveJ.firstParameter()) / 32.0);
+	}
+	Foot foot;
+	distance = signedDistance(t, &foot);
+	// Frame J on the contact point of curve J.
+	auto& curveJ = *frmJ->curve;
+	Vec3 c, d1, d2;
+	curveJ.evaluate(t, c, d1, d2);
+	frmJ->u = t;
+	frmJ->setFoot(c, d1);
+	// Frame I on its foot.
+	if (auto surfaceFrm = dynamic_cast<EndFrameqcSurface*>(frmI)) {
+		surfaceFrm->u = uI;
+		surfaceFrm->v = vI;
+		frmI->setFoot(foot.point, foot.normal);
+	}
+	else {
+		auto curveFrm = dynamic_cast<EndFrameqcCurve*>(frmI);
+		curveFrm->u = uI;
+		if (planar) {
+			frmI->setFootFrame(foot.point, foot.normal, foot.tangent);
+		}
+		else {
+			frmI->setFoot(foot.point, foot.tangent);
+		}
+	}
+}
+
+size_t TangentContact::distanceAxis() const
+{
+	if (dynamic_cast<EndFrameqcSurface*>(frmI)) {
+		return 2;
+	}
+	return planar ? 0 : SIZE_MAX;
+}
+
+bool TangentContact::envelopeTerms(double& speed, double& ftt)
+{
+	if (!initialized || std::isnan(t) || !frmJ || !frmJ->curve) {
+		return false;
+	}
+	auto& curveJ = *frmJ->curve;
+	Vec3 c, d1, d2;
+	curveJ.evaluate(t, c, d1, d2);
+	speed = std::sqrt(dot(d1, d1));
+	double range = curveJ.lastParameter() - curveJ.firstParameter();
+	double h = 1.0e-4 * range;
+	if (!curveJ.isClosed() && (t - h < curveJ.firstParameter() || t + h > curveJ.lastParameter())) {
+		return false;  // contact at an open end: no smooth minimum
+	}
+	double savedU = uI;
+	double savedV = vI;
+	double f0 = signedDistance(t, nullptr);
+	double fPlus = signedDistance(curveJ.normalizeParameter(t + h), nullptr);
+	double fMinus = signedDistance(curveJ.normalizeParameter(t - h), nullptr);
+	uI = savedU;
+	vI = savedV;
+	ftt = (fPlus - 2.0 * f0 + fMinus) / (h * h);
+	return std::isfinite(ftt) && ftt > 1.0e-9 * speed * speed;
+}
+
+bool TangentContact::distanceHessian(std::array<double, 9>& hessian)
+{
+	if (!initialized || std::isnan(uI)) {
+		return false;
+	}
+	// Directions in marker I coordinates -> global.
+	auto& aAOm = frmI->markerFrame->aAOm;
+	auto toGlobal = [&](const Vec3& v) {
+		Vec3 g = { 0.0, 0.0, 0.0 };
+		for (size_t r = 0; r < 3; r++) {
+			for (size_t k = 0; k < 3; k++) {
+				g[r] += aAOm->at(r)->at(k) * v[k];
+			}
+		}
+		return g;
+	};
+	hessian.fill(0.0);
+	auto addOuter = [&](double factor, const Vec3& a, const Vec3& b) {
+		for (size_t r = 0; r < 3; r++) {
+			for (size_t k = 0; k < 3; k++) {
+				hessian[3 * r + k] += factor * a[r] * b[k];
+			}
+		}
+	};
+	if (auto surfaceFrm = dynamic_cast<EndFrameqcSurface*>(frmI)) {
+		Vec3 p, su, sv, suu, suv, svv;
+		surfaceFrm->surface->evaluate(uI, vI, p, su, sv, suu, suv, svv);
+		Vec3 n = cross(su, sv);
+		if (!normalize(n)) {
+			return false;
+		}
+		for (auto& x : n) {
+			x *= side;
+		}
+		double e = dot(su, su);
+		double f = dot(su, sv);
+		double g = dot(sv, sv);
+		double det = e * g - f * f;
+		if (det <= 1.0e-300) {
+			return false;
+		}
+		// Dual tangent basis a1, a2 (a_i . s_j = delta_ij), second fundamental form l, m, nn.
+		Vec3 a1, a2;
+		for (size_t k = 0; k < 3; k++) {
+			a1[k] = (g * su[k] - f * sv[k]) / det;
+			a2[k] = (e * sv[k] - f * su[k]) / det;
+		}
+		double l = dot(suu, n);
+		double m = dot(suv, n);
+		double nn = dot(svv, n);
+		// Principal curvatures (eigenvalues of I^-1 II).
+		double k1 = 0.0;
+		double k2 = 0.0;
+		{
+			double w11 = (g * l - f * m) / det;
+			double w12 = (g * m - f * nn) / det;
+			double w21 = (e * m - f * l) / det;
+			double w22 = (e * nn - f * m) / det;
+			double tr = w11 + w22;
+			double dt = w11 * w22 - w12 * w21;
+			double disc = std::sqrt(std::max(0.0, tr * tr / 4.0 - dt));
+			k1 = tr / 2.0 + disc;
+			k2 = tr / 2.0 - disc;
+		}
+		// B = II (I - d II)^-1 I (first form I = [e f; f g], second II = [l m; m nn]); at d = 0
+		// it is II, in principal directions kappa / (1 - d kappa). Near or beyond a focal point
+		// (1 - d kappa -> 0, only during the iteration, far from contact) the distance is
+		// clamped continuously so that 1 - d kappa >= 1/2.
+		double d = clampedDistance(std::max(k1, k2), std::min(k1, k2));
+		double c11 = e - d * l;
+		double c12 = f - d * m;
+		double c22 = g - d * nn;
+		double cDet = c11 * c22 - c12 * c12;
+		if (std::fabs(cDet) < 1.0e-300) {
+			return false;
+		}
+		double i11 = c22 / cDet;
+		double i12 = -c12 / cDet;
+		double i22 = c11 / cDet;
+		// II * C^-1
+		double p11 = l * i11 + m * i12;
+		double p12 = l * i12 + m * i22;
+		double p21 = m * i11 + nn * i12;
+		double p22 = m * i12 + nn * i22;
+		// (II C^-1) * I, symmetrized
+		double b11 = p11 * e + p12 * f;
+		double b12 = 0.5 * ((p11 * f + p12 * g) + (p21 * e + p22 * f));
+		double b22 = p21 * f + p22 * g;
+		a1 = toGlobal(a1);
+		a2 = toGlobal(a2);
+		addOuter(-b11, a1, a1);
+		addOuter(-b12, a1, a2);
+		addOuter(-b12, a2, a1);
+		addOuter(-b22, a2, a2);
+		return true;
+	}
+	auto curveFrm = dynamic_cast<EndFrameqcCurve*>(frmI);
+	if (!planar || !curveFrm || !curveFrm->curve) {
+		return false;
+	}
+	Vec3 c, d1, d2;
+	curveFrm->curve->evaluate(uI, c, d1, d2);
+	double speed2 = dot(d1, d1);
+	Vec3 tangent = d1;
+	if (speed2 <= 1.0e-300 || !normalize(tangent)) {
+		return false;
+	}
+	Vec3 inPlane = cross(planeNormalI, tangent);
+	if (!normalize(inPlane)) {
+		return false;
+	}
+	for (auto& x : inPlane) {
+		x *= side;
+	}
+	double kappa = dot(d2, inPlane) / speed2;
+	double d = clampedDistance(kappa, kappa);
+	tangent = toGlobal(tangent);
+	addOuter(-kappa / (1.0 - d * kappa), tangent, tangent);
+	return true;
+}
+
+double TangentContact::secondDerivativeAlongJ(const Vec3& n)
+{
+	Vec3 c, d1, d2;
+	frmJ->curve->evaluate(t, c, d1, d2);
+	auto& aAOm = frmJ->markerFrame->aAOm;
+	double value = 0.0;
+	for (size_t r = 0; r < 3; r++) {
+		for (size_t k = 0; k < 3; k++) {
+			value += n[r] * aAOm->at(r)->at(k) * d2[k];
+		}
+	}
+	return value;
+}
+
+double TangentContact::slopeAlongJ(double tt)
+{
+	// d/dt of the oriented distance (envelope: the foot on I stays put to first order).
+	Foot foot;
+	signedDistance(tt, &foot);
+	Vec3 c, d1, d2;
+	frmJ->curve->evaluate(tt, c, d1, d2);
+	auto origin = toVec3(frmI->pointInMarker(frmJ->pointInGlobal({ 0.0, 0.0, 0.0 })));
+	auto tip = toVec3(frmI->pointInMarker(frmJ->pointInGlobal(d1)));
+	Vec3 n = planar || dynamic_cast<EndFrameqcSurface*>(frmI) ? foot.normal : Vec3 { 0.0, 0.0, 0.0 };
+	return dot(minus(tip, origin), n);
+}
+
+double TangentContact::refineMinimum(double tt)
+{
+	// The golden-section search resolves a flat minimum only to about sqrt(eps). A few Newton
+	// steps on the slope make the contact point exact; the second derivatives of the joint's
+	// equation (multiplied by a possibly large multiplier) depend on it.
+	if (!planar && !dynamic_cast<EndFrameqcSurface*>(frmI)) {
+		return tt;
+	}
+	auto& curveJ = *frmJ->curve;
+	double range = curveJ.lastParameter() - curveJ.firstParameter();
+	double h = 1.0e-6 * range;
+	for (int i = 0; i < 3; i++) {
+		if (!curveJ.isClosed() && (tt - h < curveJ.firstParameter() || tt + h > curveJ.lastParameter())) {
+			break;
+		}
+		double slope = slopeAlongJ(tt);
+		double curvature = (slopeAlongJ(curveJ.normalizeParameter(tt + h))
+			- slopeAlongJ(curveJ.normalizeParameter(tt - h))) / (2.0 * h);
+		if (!(curvature > 0.0)) {
+			break;
+		}
+		double step = slope / curvature;
+		if (std::fabs(step) > 1.0e-3 * range) {
+			break;  // not in the quadratic region: keep the golden-section result
+		}
+		tt = curveJ.normalizeParameter(tt - step);
+		if (std::fabs(step) < 1.0e-15 * range) {
+			break;
+		}
+	}
+	return tt;
+}
+
+double TangentContact::clampedDistance(double kappaMax, double kappaMin) const
+{
+	// Largest d * kappa over the principal curvatures; keep 1 - d kappa >= 1/2.
+	double worst = std::max(distance * kappaMax, distance * kappaMin);
+	return worst > 0.5 ? distance * 0.5 / worst : distance;
+}
+
+double TangentContact::exactSecondDerivativeWeight() const
+{
+	double length = 0.05 * sizeJ;
+	if (!(length > 0.0)) {
+		return 1.0;
+	}
+	double ratio = distance / length;
+	return std::exp(-ratio * ratio);
+}
+
+bool TangentContact::contactOffset(Vec3& offset)
+{
+	if (!frmI || !frmJ || !frmJ->curve) {
+		return false;
+	}
+	update();
+	auto pJ = frmJ->rOeO;
+	auto pI = frmI->rOeO;
+	size_t axis = distanceAxis();
+	for (size_t k = 0; k < 3; k++) {
+		offset[k] = axis == SIZE_MAX ? pJ->at(k) - pI->at(k) : distance * frmI->aAOe->at(k)->at(axis);
+	}
+	return std::isfinite(offset[0]) && std::isfinite(offset[1]) && std::isfinite(offset[2]);
+}
