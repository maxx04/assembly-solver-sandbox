+#include "DispCompIeqcJeqcKeqc.h"
+#include "TranslationConstraintIqcJqc.h"
+
+namespace MbD {
+	class EndFrameqcCurve;
+
+	// Displacement component along an axis of an EndFrameqcCurve. Moves the frame to the
+	// current foot point of end frame J before evaluating, so value and derivatives always
+	// belong to the tangent line at the closest curve point.
+	class DispCompIeqcJeqcKeqcCurve : public DispCompIeqcJeqcKeqc
+	{
+		//
+	public:
+		DispCompIeqcJeqcKeqcCurve(EndFrmsptr frmi, EndFrmsptr frmj, EndFrmsptr frmk, size_t axisk);
+		void calcPostDynCorrectorIteration() override;
+	};
+
+	// One of the two equations of a PointOnCurveJoint: component of (rJ - foot point) along
+	// axis 0 or 1 of the curve frame (both perpendicular to the tangent) is zero.
+	class PointOnCurveConstraintIqcJqc : public TranslationConstraintIqcJqc
+	{
+		//
+	public:
+		PointOnCurveConstraintIqcJqc(EndFrmsptr frmi, EndFrmsptr frmj, size_t axisi);
+		void initriIeJeIe() override;
+		std::string constraintSpec() override;
+		// Adds the envelope correction to the frozen second derivatives of a contact distance
+		// equation (TangentContact): the contact point on curve J is the minimum over its
+		// parameter t, so the true Hessian is the frozen one minus g g^T / f_tt with
+		// g = d(df/dt)/dq. Without it a free motion that moves the contact point along J (a wheel
+		// spinning about its axis, rolling) looked stiff, times the multiplier, and the assembly
+		// converged only by tiny drifts.
+		void fillPosICJacob(SpMatDsptr mat) override;
+	};
+
+}
