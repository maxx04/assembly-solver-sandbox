+			auto eqnNos = std::make_shared<FullColumn<size_t>>(redundant->begin(), redundant->end());
+			throw SingularMatrixError("", eqnNos);
+		}
+		// Keine abhaengige Gleichung: die Matrix ist nur schlecht konditioniert, der schnelle Loeser
+		// (Markowitz) gab zu frueh auf. Erst der genaue Loeser mit Skalierung, die volle Pivotsuche
+		// (an BG22 ~1.5 s pro Solve) nur, wenn auch der scheitert.
+		try {
+			auto marko = CREATE<GESpMatParPvMarko>::With();
+			dx = marko->solvewithsaveOriginal(pypx, y->negated(), false);
+			system->logString("MbD: Redundanzsuche nach Rangfolge: keine Redundanz, Markowitz-Loeser genuegt.");
+			return;
+		}
+		catch (const SingularMatrixError&) {
+		}
+		try {
+			auto precise = CREATE<GESpMatParPvPrecise>::With();
+			dx = precise->solvewithsaveOriginal(pypx, y->negated(), false);
+			system->logString("MbD: Redundanzsuche nach Rangfolge: keine Redundanz, genauer Loeser genuegt.");
+			return;
+		}
+		catch (const SingularMatrixError&) {
+		}
+	}
 	auto posICsolver = CREATE<GESpMatFullPvPosIC>::With();
 	posICsolver->system = this;
-	dx = posICsolver->solvewithsaveOriginal(pypx, y->negated(), false);
+	try {
+		dx = posICsolver->solvewithsaveOriginal(pypx, y->negated(), false);
+	}
+	catch (const SingularMatrixError& ex) {
+		recordRedundancyGroups(constraintRows, ex.getRedundantEqnNos());
+		throw;
+	}
+}
+
+// Gleichungen nach Rang des Gelenks (dann Gleichungsnummer) ordnen und der Reihe nach gegen die
+// bisher aufgenommenen orthogonalisieren (modifiziertes Gram-Schmidt, zweifach). Bleibt kaum Rest,
+// haengt die Gleichung von verlaesslicheren ab und ist redundant.
+std::shared_ptr<std::vector<size_t>> PosICNewtonRaphson::redundantEqnsByPriority(
+	const std::map<size_t, std::map<size_t, double>>& constraintRows)
+{
+	auto redundant = std::make_shared<std::vector<size_t>>();
+	const auto& priority = system->system->jointPriority;
+	std::map<size_t, long> eqnRank;
+	system->system->jointsMotionsDo([&](std::shared_ptr<Joint> joint) {
+		std::string key = joint->name;
+		const auto slash = key.find('/', 1);
+		if (!key.empty() && key[0] == '/' && slash != std::string::npos) {
+			key = key.substr(slash + 1);
+		}
+		auto it = priority.find(key);
+		const long rank = it != priority.end() ? it->second : 0;
+		joint->constraintsDo([&](std::shared_ptr<Constraint> con) {
+			eqnRank[con->iG] = rank;
+		});
+	});
+	std::vector<size_t> order;
+	for (const auto& [eqn, row] : constraintRows) {
+		order.push_back(eqn);
+	}
+	std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+		const long ra = eqnRank.count(a) ? eqnRank[a] : 0;
+		const long rb = eqnRank.count(b) ? eqnRank[b] : 0;
+		return ra < rb;
+	});
+	const size_t nCols = nqsu;
+	std::vector<std::vector<double>> basis;
+	for (size_t eqn : order) {
+		const auto& row = constraintRows.at(eqn);
+		std::vector<double> v(nCols, 0.0);
+		double norm0 = 0.0;
+		for (const auto& [col, value] : row) {
+			v[col] = value;
+			norm0 += value * value;
+		}
+		norm0 = std::sqrt(norm0);
+		if (norm0 == 0.0) {
+			continue;
+		}
+		for (int pass = 0; pass < 2; ++pass) {
+			for (const auto& q : basis) {
+				double dot = 0.0;
+				for (size_t c = 0; c < nCols; ++c) {
+					dot += q[c] * v[c];
+				}
+				if (dot != 0.0) {
+					for (size_t c = 0; c < nCols; ++c) {
+						v[c] -= dot * q[c];
+					}
+				}
+			}
+		}
+		double norm = 0.0;
+		for (double x : v) {
+			norm += x * x;
+		}
+		norm = std::sqrt(norm);
+		// 1e-6: an BG22 blieb bei einer um 89 Grad verletzten Parallel-Bedingung ein Rest von ~1e-7,
+		// den OndselSolvers eigene Zerlegung bereits als singulaer wertet.
+		if (norm <= 1.0e-6 * norm0) {
+			redundant->push_back(eqn);
+			continue;
+		}
+		for (double& x : v) {
+			x /= norm;
+		}
+		basis.push_back(std::move(v));
+	}
+	std::string str = "MbD: Redundanzsuche nach Rangfolge: " + std::to_string(redundant->size())
+		+ " redundante Gleichung(en).";
+	system->logString(str);
+	return redundant;
+}
+
+void PosICNewtonRaphson::recordRedundancyGroups(
+	const std::map<size_t, std::map<size_t, double>>& constraintRows,
+	const std::shared_ptr<std::vector<size_t>>& redundantEqnNos)
+{
+	if (!redundantEqnNos || !system || !system->system) {
+		return;
+	}
+	std::map<size_t, std::string> eqnToJoint;
+	system->system->jointsMotionsDo([&](std::shared_ptr<Joint> joint) {
+		joint->constraintsDo([&](std::shared_ptr<Constraint> con) {
+			eqnToJoint[con->iG] = joint->name;
+		});
+	});
+	const std::set<size_t> redundant(redundantEqnNos->begin(), redundantEqnNos->end());
+	std::vector<size_t> basis;
+	for (const auto& [eqn, row] : constraintRows) {
+		if (!row.empty() && redundant.find(eqn) == redundant.end()) {
+			basis.push_back(eqn);
+		}
+	}
+	const size_t k = basis.size();
+	if (k == 0) {
+		return;
+	}
+	std::vector<std::vector<double>> M(k, std::vector<double>(k, 0.0));
+	for (size_t i = 0; i < k; ++i) {
+		const auto& rowI = constraintRows.at(basis[i]);
+		for (size_t j = i; j < k; ++j) {
+			M[i][j] = M[j][i] = dotRows(rowI, constraintRows.at(basis[j]));
+		}
+	}
+	for (size_t eqn : redundant) {
+		auto rowIt = constraintRows.find(eqn);
+		auto jointIt = eqnToJoint.find(eqn);
+		if (rowIt == constraintRows.end() || jointIt == eqnToJoint.end()) {
+			continue;
+		}
+		const double rowNorm = std::sqrt(dotRows(rowIt->second, rowIt->second));
+		std::vector<double> b(k);
+		for (size_t i = 0; i < k; ++i) {
+			b[i] = dotRows(constraintRows.at(basis[i]), rowIt->second);
+		}
+		const std::vector<double> c = solveDense(M, b);
+		std::set<std::string> involved;
+		for (size_t i = 0; i < k; ++i) {
+			const double contribution = std::abs(c[i]) * std::sqrt(M[i][i]);
+			if (contribution > 1.0e-6 * rowNorm) {
+				auto owner = eqnToJoint.find(basis[i]);
+				if (owner != eqnToJoint.end()) {
+					involved.insert(owner->second);
+				}
+			}
+		}
+		// Minimale Gruppe: Gelenke einzeln weglassen, solange die entnommene Zeile noch im
+		// Spann der uebrigen liegt (Zeilen ohne Gelenk, z.B. Euler-Normierung der Koerper,
+		// bleiben immer). Die Kleinste-Quadrate-Loesung oben verteilt die Abhaengigkeit auf
+		// alle moeglichen Pfade; uebrig bleibt hier die eigentliche geschlossene Schleife.
+		auto inSpan = [&](const std::set<std::string>& joints) {
+			std::vector<size_t> rows;
+			for (size_t eqnI : basis) {
+				auto owner = eqnToJoint.find(eqnI);
+				if (owner == eqnToJoint.end() || owner->second == jointIt->second
+					|| joints.count(owner->second)) {
+					rows.push_back(eqnI);
+				}
+			}
+			const size_t m = rows.size();
+			std::vector<std::vector<double>> Ms(m, std::vector<double>(m, 0.0));
+			std::vector<double> bs(m);
+			for (size_t i = 0; i < m; ++i) {
+				const auto& rowI = constraintRows.at(rows[i]);
+				for (size_t j = i; j < m; ++j) {
+					Ms[i][j] = Ms[j][i] = dotRows(rowI, constraintRows.at(rows[j]));
+				}
+				bs[i] = dotRows(rowI, rowIt->second);
+			}
+			const std::vector<double> cs = solveDense(Ms, bs);
+			SparseRowCopy residual = rowIt->second;
+			for (size_t i = 0; i < m; ++i) {
+				for (const auto& [col, value] : constraintRows.at(rows[i])) {
+					residual[col] -= cs[i] * value;
+				}
+			}
+			return std::sqrt(dotRows(residual, residual)) <= 1.0e-6 * rowNorm;
+		};
+		involved.erase(jointIt->second);
+		if (inSpan(involved)) {
+			const std::vector<std::string> candidates(involved.begin(), involved.end());
+			for (const auto& candidate : candidates) {
+				std::set<std::string> trial = involved;
+				trial.erase(candidate);
+				if (inSpan(trial)) {
+					involved = std::move(trial);
+				}
+			}
+		}
+		involved.insert(jointIt->second);
+		system->system->redundancyGroups.emplace_back(
+			jointIt->second, std::vector<std::string>(involved.begin(), involved.end()));
+		std::string msg = "MbD: Redundanzgruppe von " + jointIt->second + ":";
+		for (const auto& name : involved) {
+			msg += " " + name;
+		}
+		system->logString(msg);
+	}
 }
