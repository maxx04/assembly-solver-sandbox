+void MbD::System::applyKnownRedundantConstraints()
+{
+	appliedKnownRedundantConstraints = 0;
+	if (knownRedundantConstraints.empty()) {
+		return;
+	}
+	for (auto& joint : *jointsMotions) {
+		auto& cons = *joint->constraints;
+		for (size_t i = 0; i < cons.size(); i++) {
+			if (cons[i]->isRedundant()
+				|| knownRedundantConstraints.count({joint->name, i}) == 0) {
+				continue;
+			}
+			auto redunCon = CREATE<RedundantConstraint>::With();
+			redunCon->constraint = cons[i];
+			cons[i] = redunCon;
+			appliedKnownRedundantConstraints++;
+		}
+	}
+	std::string str = "MbD: " + std::to_string(appliedKnownRedundantConstraints)
+		+ " bekannte redundante Bedingung(en) vorab herausgenommen.";
+	logString(str);
+}
+
+std::vector<MbD::System::RedundantConstraintState> MbD::System::redundantConstraintStates()
+{
+	std::vector<RedundantConstraintState> states;
+	for (auto& joint : *jointsMotions) {
+		auto& cons = *joint->constraints;
+		for (size_t i = 0; i < cons.size(); i++) {
+			if (!cons[i]->isRedundant()) {
+				continue;
+			}
+			auto inner = std::static_pointer_cast<RedundantConstraint>(cons[i])->constraint;
+			if (!inner) {
+				continue;
+			}
+			inner->prePosIC();
+			inner->postPosICIteration();
+			// classname() ist unter GCC ein verstuemmelter Typname - Art ueber den Typ bestimmen.
+			const bool isAngle = std::dynamic_pointer_cast<DirectionCosineConstraintIJ>(inner) != nullptr;
+			states.push_back({joint->name, i, inner->aG, isAngle});
+		}
+	}
+	return states;
+}
