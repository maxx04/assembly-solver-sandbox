diff --git a/src/3rdParty/OndselSolver/OndselSolver/EndFrameqcFoot.cpp b/src/3rdParty/OndselSolver/OndselSolver/EndFrameqcFoot.cpp
new file mode 100644
index 0000000..fbfc81c
--- /dev/null
+++ b/src/3rdParty/OndselSolver/OndselSolver/EndFrameqcFoot.cpp
@@ -0,0 +1,123 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#include <cmath>
+
+#include "EndFrameqcFoot.h"
+#include "MarkerFrame.h"
+#include "TangentContact.h"
+
+using namespace MbD;
+
+namespace {
+	using Vec3 = MbD::NurbsCurve::Vec3;
+
+	double dot(const Vec3& a, const Vec3& b)
+	{
+		return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+	}
+
+	Vec3 cross(const Vec3& a, const Vec3& b)
+	{
+		return { a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0] };
+	}
+
+	bool normalize(Vec3& a)
+	{
+		double len = std::sqrt(dot(a, a));
+		if (len < 1.0e-300) {
+			return false;
+		}
+		for (auto& x : a) {
+			x /= len;
+		}
+		return true;
+	}
+
+	// x axis perpendicular to z, as close as possible to ref.
+	Vec3 perpendicularTo(const Vec3& z, const Vec3& ref)
+	{
+		Vec3 x = ref;
+		double along = dot(x, z);
+		for (size_t i = 0; i < 3; i++) {
+			x[i] -= along * z[i];
+		}
+		if (dot(x, x) < 0.01) {
+			size_t k = 0;
+			for (size_t i = 1; i < 3; i++) {
+				if (std::fabs(z[i]) < std::fabs(z[k])) {
+					k = i;
+				}
+			}
+			x = { 0.0, 0.0, 0.0 };
+			x[k] = 1.0;
+			along = dot(x, z);
+			for (size_t i = 0; i < 3; i++) {
+				x[i] -= along * z[i];
+			}
+		}
+		normalize(x);
+		return x;
+	}
+}
+
+EndFrameqcFoot::EndFrameqcFoot() {
+}
+
+EndFrameqcFoot::EndFrameqcFoot(const std::string& str) : EndFrameqcOffset(str) {
+}
+
+void EndFrameqcFoot::updateFor(EndFrmsptr frmJ)
+{
+	if (contact) {
+		contact->update();
+	}
+	else {
+		updateFootPoint(frmJ->rOeO);
+	}
+}
+
+FColDsptr EndFrameqcFoot::pointInMarker(FColDsptr rOpO)
+{
+	auto rmpO = rOpO->minusFullColumn(markerFrame->rOmO);
+	return markerFrame->aAOm->transposeTimesFullColumn(rmpO);
+}
+
+FColDsptr EndFrameqcFoot::pointInGlobal(const Vec3& rmpm)
+{
+	auto local = std::make_shared<FullColumn<double>>(3, 0.0);
+	for (size_t i = 0; i < 3; i++) {
+		local->at(i) = rmpm[i];
+	}
+	return markerFrame->rOmO->plusFullColumn(markerFrame->aAOm->timesFullColumn(local));
+}
+
+void EndFrameqcFoot::setFoot(const Vec3& origin, const Vec3& zAxis)
+{
+	Vec3 z = zAxis;
+	if (!normalize(z)) {
+		// Degenerate (zero tangent or normal): keep the previous direction.
+		z = { aAme->at(0)->at(2), aAme->at(1)->at(2), aAme->at(2)->at(2) };
+	}
+	Vec3 x = perpendicularTo(z, refX);
+	refX = x;
+	Vec3 y = cross(z, x);
+	for (size_t i = 0; i < 3; i++) {
+		rmem->at(i) = origin[i];
+		aAme->at(i)->at(0) = x[i];
+		aAme->at(i)->at(1) = y[i];
+		aAme->at(i)->at(2) = z[i];
+	}
+	calcPostDynCorrectorIteration();
+}
+
+void EndFrameqcFoot::setFootFrame(const Vec3& origin, const Vec3& xAxis, const Vec3& zAxis)
+{
+	refX = xAxis;
+	setFoot(origin, zAxis);
+}
