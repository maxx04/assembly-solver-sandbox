+
+void MbD::ASMTTangentJoint::createMbD(std::shared_ptr<System> mbdSys, std::shared_ptr<Units> mbdUnits)
+{
+	if (kind != "PointOnSurface" && kind != "CurveOnSurface" && kind != "CurveOnCurve") {
+		throw SimulationStoppingError("TangentJoint " + name + ": unknown kind '" + kind + "'.");
+	}
+	std::shared_ptr<EndFrameqcFoot> frmI;
+	if (kind == "CurveOnCurve") {
+		auto curveFrm = CREATE<EndFrameqcCurve>::With();
+		curveFrm->curve = makeCurve(curveI, mbdUnits->length, name);
+		frmI = curveFrm;
+	}
+	else {
+		auto surfaceFrm = CREATE<EndFrameqcSurface>::With();
+		surfaceFrm->surface = makeSurface(surfaceI, mbdUnits->length, name);
+		frmI = surfaceFrm;
+	}
+	std::shared_ptr<EndFrameqcCurve> frmJCurve;
+	if (kind != "PointOnSurface") {
+		frmJCurve = CREATE<EndFrameqcCurve>::With();
+		frmJCurve->curve = makeCurve(curveJ, mbdUnits->length, name);
+	}
+
+	ASMTJoint::createMbD(mbdSys, mbdUnits);
+	auto mbdJt = std::static_pointer_cast<Joint>(mbdObject);
+	auto mrkI = std::static_pointer_cast<EndFramec>(root()->markerAt(markerI)->mbdObject);
+	auto mrkJ = std::static_pointer_cast<EndFramec>(root()->markerAt(markerJ)->mbdObject);
+	mrkI->getMarkerFrame()->addEndFrame(frmI);
+	if (frmJCurve) {
+		mrkJ->getMarkerFrame()->addEndFrame(frmJCurve);
+		auto contact = std::make_shared<TangentContact>();
+		contact->frmI = frmI.get();
+		contact->frmJ = frmJCurve.get();
+		frmI->contact = contact;
+		mbdJt->connectsItoJ(frmI, frmJCurve);
+	}
+	else {
+		mbdJt->connectsItoJ(frmI, mrkJ);
+	}
+}
+
+void MbD::ASMTTangentJoint::parseASMT(std::vector<std::string>& lines)
+{
+	ASMTJoint::parseASMT(lines);
+	auto take = [&](const std::string& label) {
+		if (!lines.empty() && lines[0].find(label) != std::string::npos) {
+			lines.erase(lines.begin());
+			std::string value = lines[0];
+			lines.erase(lines.begin());
+			return value;
+		}
+		return std::string();
+	};
+	auto takeDoubles = [&](const std::string& label, std::vector<double>& values) {
+		values.clear();
+		std::string row = take(label);
+		if (!row.empty()) {
+			auto parsed = readRowOfDoubles(row);
+			values.assign(parsed->begin(), parsed->end());
+		}
+	};
+	auto takeCurve = [&](const std::string& prefix, Curve& c) {
+		std::string row = take(prefix + "degree");
+		c.degree = row.empty() ? 0 : (size_t)readInt(row);
+		row = take(prefix + "closed");
+		c.closed = !row.empty() && readBool(row);
+		takeDoubles(prefix + "knots", c.knots);
+		takeDoubles(prefix + "weights", c.weights);
+		takeDoubles(prefix + "poles", c.poles);
+	};
+	std::string row = take("kind");
+	kind = row;
+	kind.erase(0, kind.find_first_not_of(" \t"));
+	if (kind == "CurveOnCurve") {
+		takeCurve("curveI", curveI);
+	}
+	else {
+		auto takeInt = [&](const std::string& label) {
+			std::string r = take(label);
+			return r.empty() ? (size_t)0 : (size_t)readInt(r);
+		};
+		auto takeBool = [&](const std::string& label) {
+			std::string r = take(label);
+			return !r.empty() && readBool(r);
+		};
+		surfaceI.degreeU = takeInt("surfaceDegreeU");
+		surfaceI.degreeV = takeInt("surfaceDegreeV");
+		surfaceI.nPolesU = takeInt("surfacePolesU");
+		surfaceI.nPolesV = takeInt("surfacePolesV");
+		surfaceI.closedU = takeBool("surfaceClosedU");
+		surfaceI.closedV = takeBool("surfaceClosedV");
+		takeDoubles("surfaceKnotsU", surfaceI.knotsU);
+		takeDoubles("surfaceKnotsV", surfaceI.knotsV);
+		takeDoubles("surfaceWeights", surfaceI.weights);
+		takeDoubles("surfacePoles", surfaceI.poles);
+	}
+	if (kind != "PointOnSurface") {
+		takeCurve("curveJ", curveJ);
+	}
+}
+
+void MbD::ASMTTangentJoint::storeOnLevel(std::ofstream& os, size_t level)
+{
+	// Not ASMTJoint::storeOnLevel(): it derives the type name from typeid().name(), which only
+	// gives the right text with MSVC.
+	storeOnLevelString(os, level, "TangentJoint");
+	ASMTItemIJ::storeOnLevel(os, level);
+	storeOnLevelString(os, level + 1, "kind");
+	storeOnLevelString(os, level + 2, kind);
+	auto storeCurve = [&](const std::string& prefix, const Curve& c) {
+		storeOnLevelString(os, level + 1, prefix + "degree");
+		storeOnLevelInt(os, level + 2, (int)c.degree);
+		storeOnLevelString(os, level + 1, prefix + "closed");
+		storeOnLevelBool(os, level + 2, c.closed);
+		storeOnLevelString(os, level + 1, prefix + "knots");
+		storeDoubles(os, level + 2, c.knots);
+		storeOnLevelString(os, level + 1, prefix + "weights");
+		storeDoubles(os, level + 2, c.weights);
+		storeOnLevelString(os, level + 1, prefix + "poles");
+		storeDoubles(os, level + 2, c.poles);
+	};
+	if (kind == "CurveOnCurve") {
+		storeCurve("curveI", curveI);
+	}
+	else {
+		storeOnLevelString(os, level + 1, "surfaceDegreeU");
+		storeOnLevelInt(os, level + 2, (int)surfaceI.degreeU);
+		storeOnLevelString(os, level + 1, "surfaceDegreeV");
+		storeOnLevelInt(os, level + 2, (int)surfaceI.degreeV);
+		storeOnLevelString(os, level + 1, "surfacePolesU");
+		storeOnLevelInt(os, level + 2, (int)surfaceI.nPolesU);
+		storeOnLevelString(os, level + 1, "surfacePolesV");
+		storeOnLevelInt(os, level + 2, (int)surfaceI.nPolesV);
+		storeOnLevelString(os, level + 1, "surfaceClosedU");
+		storeOnLevelBool(os, level + 2, surfaceI.closedU);
+		storeOnLevelString(os, level + 1, "surfaceClosedV");
+		storeOnLevelBool(os, level + 2, surfaceI.closedV);
+		storeOnLevelString(os, level + 1, "surfaceKnotsU");
+		storeDoubles(os, level + 2, surfaceI.knotsU);
+		storeOnLevelString(os, level + 1, "surfaceKnotsV");
+		storeDoubles(os, level + 2, surfaceI.knotsV);
+		storeOnLevelString(os, level + 1, "surfaceWeights");
+		storeDoubles(os, level + 2, surfaceI.weights);
+		storeOnLevelString(os, level + 1, "surfacePoles");
+		storeDoubles(os, level + 2, surfaceI.poles);
+	}
+	if (kind != "PointOnSurface") {
+		storeCurve("curveJ", curveJ);
+	}
+}
+
+void MbD::ASMTTangentJoint::storeOnTimeSeries(std::ofstream& os)
+{
+	os << "TangentJointSeries\t" << fullName("") << std::endl;
+	ASMTItemIJ::storeOnTimeSeries(os);
+}
