+
+#pragma once
+
+#include <limits>
+#include <vector>
+
+#include "NurbsCurve.h"
+
+namespace MbD {
+	// Rational tensor-product B-spline surface, used by the Tangent joints on a face. The surface
+	// is given in the coordinates of the marker it is attached to. Poles and weights are stored
+	// row by row: index i * nPolesV + j for pole i in u and j in v.
+	class NurbsSurface
+	{
+	public:
+		using Vec3 = NurbsCurve::Vec3;
+
+		NurbsSurface(size_t degreeU, size_t degreeV, std::vector<double> knotsU,
+			std::vector<double> knotsV, size_t nPolesU, size_t nPolesV,
+			std::vector<double> weights, std::vector<Vec3> poles, bool closedU, bool closedV);
+
+		bool isValid() const;
+		double firstU() const;
+		double lastU() const;
+		double firstV() const;
+		double lastV() const;
+		double normalizeU(double u) const;
+		double normalizeV(double v) const;
+		void evaluate(double u, double v, Vec3& s, Vec3& su, Vec3& sv, Vec3& suu, Vec3& suv,
+			Vec3& svv) const;
+		Vec3 value(double u, double v) const;
+		// Unit normal su x sv (zero vector at a degenerate point).
+		Vec3 normal(double u, double v) const;
+		// Parameters of the surface point closest to p. u, v are the start of a local search on
+		// input; with NaN a sampling of the whole surface gives the start.
+		void project(const Vec3& p, double& u, double& v) const;
+		void scale(double factor);
+
+		size_t degreeU, degreeV, nPolesU, nPolesV;
+		std::vector<double> knotsU, knotsV, weights;
+		std::vector<Vec3> poles;
+		bool closedU, closedV;
+
+	private:
+		void sampleStart(const Vec3& p, double& u, double& v) const;
+	};
+
+	// B-spline basis functions shared by NurbsSurface (The NURBS Book, A2.1 and A2.3).
+	size_t nurbsFindSpan(const std::vector<double>& knots, size_t degree, size_t nPoles, double u);
+	void nurbsDersBasisFuns(const std::vector<double>& knots, size_t degree, size_t span, double u,
+		size_t nDerivs, std::vector<std::vector<double>>& ders);
+}
