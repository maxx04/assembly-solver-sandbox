+++ b/src/3rdParty/OndselSolver/OndselSolver/TangentContact.h
@@ -0,0 +1,87 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#pragma once
+
+#include <array>
+#include <limits>
+
+#include "NurbsCurve.h"
+
+namespace MbD {
+	class EndFrameqcFoot;
+	class EndFrameqcCurve;
+
+	// Contact between geometry I (surface or curve, end frame frmI) and curve J (end frame frmJ),
+	// both fixed to their markers. The contact point on J is the one with the smallest signed
+	// distance to I (deepest penetration, or closest approach from outside), measured along the
+	// surface normal or, for a planar curve I, along the in-plane normal. Requiring that distance
+	// to be zero makes J touch I from one side: tangency and "no penetration" follow from the
+	// choice of the point, so the joints need only translation equations. The side is the one
+	// most of curve J lies on at the first evaluation. Two space curves (neither planar): the
+	// contact point is the closest pair of points instead (they meet, tangency not enforced).
+	// update() moves frmJ to the contact point on J and frmI to its foot on I; frmI's z axis is
+	// the oriented surface normal (surface) or the tangent of I with x along the oriented
+	// in-plane normal and y out of the plane (curve). Owned by frmI, hence plain pointers.
+	class TangentContact
+	{
+	public:
+		using Vec3 = NurbsCurve::Vec3;
+		void update();
+		// Vector from the foot on I to the contact point on J along the distance direction
+		// (global), for setting the curve down before a position solve. false if unavailable.
+		bool contactOffset(Vec3& offset);
+		// Axis of frmI along which the joint's equation measures the contact distance: 2 (surface
+		// normal) or 0 (in-plane normal of a planar curve); SIZE_MAX for two space curves.
+		size_t distanceAxis() const;
+		// For the envelope correction of the distance equation's second derivatives
+		// (PointOnCurveConstraintIqcJqc::fillPosICJacob): speed = |dJ/dt| at the contact point,
+		// ftt = second derivative of the oriented distance with respect to t (> 0 at a proper
+		// minimum). false if not available.
+		bool envelopeTerms(double& speed, double& ftt);
+		// Hessian of the oriented distance field of I at the contact point of J (distance d from
+		// the foot), global coordinates, row-major 3x3: curvature kappa of I becomes
+		// -kappa / (1 - d kappa) in the tangent directions (surface: second fundamental form,
+		// planar curve: along the tangent). false for two space curves. Near or beyond a focal
+		// point (only far from contact, during the iteration) d is clamped continuously.
+		bool distanceHessian(std::array<double, 9>& hessian);
+		// n . d2x/dt2 at the contact point of J, n and the result global.
+		double secondDerivativeAlongJ(const Vec3& n);
+		// Weight of the exact second derivatives: 1 at contact, fading out smoothly with the
+		// distance (exp(-(d/L)^2), L = 5 % of the size of curve J). Far from contact (first
+		// iterations) the exact terms made the Newton iteration fragile.
+		double exactSecondDerivativeWeight() const;
+		EndFrameqcFoot* frmI = nullptr;
+		EndFrameqcCurve* frmJ = nullptr;
+
+	private:
+		struct Foot
+		{
+			Vec3 point = { 0.0, 0.0, 0.0 };   // foot on I, marker I coordinates
+			Vec3 normal = { 0.0, 0.0, 0.0 };  // oriented normal (surface) or in-plane normal (curve)
+			Vec3 tangent = { 0.0, 0.0, 0.0 }; // tangent of curve I
+		};
+		void initialize();
+		// Oriented signed distance of the point of J at parameter t (marker I coordinates).
+		double signedDistance(double t, Foot* foot);
+		double minimizeAround(double t0, double halfWidth);
+		double slopeAlongJ(double t);
+		double refineMinimum(double t);
+		double clampedDistance(double kappaMax, double kappaMin) const;
+
+		bool initialized = false;
+		bool planar = false;        // curve I case: in-plane normal available
+		double side = 1.0;
+		double distance = 0.0;      // oriented distance at the last update()
+		double sizeJ = 0.0;         // diagonal of the bounding box of curve J's poles
+		Vec3 planeNormalI = { 0.0, 0.0, 1.0 };  // marker I coordinates
+		double t = std::numeric_limits<double>::quiet_NaN();
+		double uI = std::numeric_limits<double>::quiet_NaN();
+		double vI = std::numeric_limits<double>::quiet_NaN();
+	};
+}
diff --git a/src/3rdParty/OndselSolver/OndselSolver/TangentJoints.cpp b/src/3rdParty/OndselSolver/OndselSolver/TangentJoints.cpp
new file mode 100644
index 0000000..9e06895
--- /dev/null
+++ b/src/3rdParty/OndselSolver/OndselSolver/TangentJoints.cpp
@@ -0,0 +1,155 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#include "TangentJoints.h"
+#include "PointOnCurveConstraintIqcJqc.h"
+#include "CREATE.h"
+#include "System.h"
+#include "EndFrameqcFoot.h"
+#include "MarkerFrame.h"
+#include "PartFrame.h"
+#include "TangentContact.h"
+
+using namespace MbD;
+
+namespace {
+	size_t jointsOnPart(System* system, PartFrame* partFrame)
+	{
+		size_t count = 0;
+		system->jointsMotionsDo([&](std::shared_ptr<Joint> joint) {
+			if (joint->frmI && joint->frmI->markerFrame && joint->frmI->markerFrame->partFrame == partFrame) {
+				count++;
+			}
+			else if (joint->frmJ && joint->frmJ->markerFrame && joint->frmJ->markerFrame->partFrame == partFrame) {
+				count++;
+			}
+		});
+		return count;
+	}
+
+	void updateFrames(PartFrame* partFrame)
+	{
+		partFrame->calcPostDynCorrectorIteration();
+		partFrame->markerFramesDo([](std::shared_ptr<MarkerFrame> markerFrame) {
+			markerFrame->calcPostDynCorrectorIteration();
+		});
+	}
+
+	// Before the position solve: move the part that hangs only on this contact along the contact
+	// normal until the curve touches (a wheel set down onto the surface). PosIC keeps the parts
+	// as close as possible to where they start, weighting a millimetre of travel far above a
+	// radian of rotation; from a distant start it rather tilts and spins the curve, the
+	// multiplier of the contact equation grows large and the iteration easily wanders. From the
+	// touching start only small corrections remain. Parts connected by further joints are left
+	// where they are.
+	void setDownOnContact(Joint* joint)
+	{
+		auto footI = std::dynamic_pointer_cast<EndFrameqcFoot>(joint->frmI);
+		if (!footI || !footI->contact || !joint->frmJ || !joint->frmJ->markerFrame) {
+			return;
+		}
+		auto* partI = footI->markerFrame->partFrame;
+		auto* partJ = joint->frmJ->markerFrame->partFrame;
+		if (!partI || !partJ || partI == partJ) {
+			return;
+		}
+		auto* system = joint->root();
+		bool moveJ = jointsOnPart(system, partJ) == 1;
+		bool moveI = !moveJ && jointsOnPart(system, partI) == 1;
+		if (!moveJ && !moveI) {
+			return;
+		}
+		updateFrames(partI);
+		updateFrames(partJ);
+		TangentContact::Vec3 offset;
+		if (!footI->contact->contactOffset(offset)) {
+			return;
+		}
+		auto* part = moveJ ? partJ : partI;
+		double sign = moveJ ? -1.0 : 1.0;
+		auto qX = part->getqX();
+		for (size_t k = 0; k < 3; k++) {
+			qX->at(k) += sign * offset[k];
+		}
+		updateFrames(part);
+		footI->contact->update();  // end frames of the contact at the new position
+	}
+}
+
+MbD::PointOnSurfaceJoint::PointOnSurfaceJoint()
+{
+}
+
+MbD::PointOnSurfaceJoint::PointOnSurfaceJoint(const std::string& str) : Joint(str)
+{
+}
+
+void MbD::PointOnSurfaceJoint::initializeGlobally()
+{
+	if (constraints->empty())
+	{
+		addConstraint(CREATE<PointOnCurveConstraintIqcJqc>::With(frmI, frmJ, 2));
+		this->root()->hasChanged = true;
+	}
+	else {
+		Joint::initializeGlobally();
+	}
+}
+
+MbD::CurveOnSurfaceJoint::CurveOnSurfaceJoint()
+{
+}
+
+MbD::CurveOnSurfaceJoint::CurveOnSurfaceJoint(const std::string& str) : Joint(str)
+{
+}
+
+void MbD::CurveOnSurfaceJoint::initializeGlobally()
+{
+	if (constraints->empty())
+	{
+		addConstraint(CREATE<PointOnCurveConstraintIqcJqc>::With(frmI, frmJ, 2));
+		this->root()->hasChanged = true;
+	}
+	else {
+		Joint::initializeGlobally();
+	}
+}
+
+MbD::CurveOnCurveJoint::CurveOnCurveJoint()
+{
+}
+
+MbD::CurveOnCurveJoint::CurveOnCurveJoint(const std::string& str) : Joint(str)
+{
+}
+
+void MbD::CurveOnCurveJoint::initializeGlobally()
+{
+	if (constraints->empty())
+	{
+		addConstraint(CREATE<PointOnCurveConstraintIqcJqc>::With(frmI, frmJ, 0));
+		addConstraint(CREATE<PointOnCurveConstraintIqcJqc>::With(frmI, frmJ, 1));
+		this->root()->hasChanged = true;
+	}
+	else {
+		Joint::initializeGlobally();
+	}
+}
+
+void MbD::CurveOnSurfaceJoint::prePosIC()
+{
+	setDownOnContact(this);  // before the constraints evaluate themselves
+	Joint::prePosIC();
+}
+
+void MbD::CurveOnCurveJoint::prePosIC()
+{
+	setDownOnContact(this);  // before the constraints evaluate themselves
+	Joint::prePosIC();
+}
