+EndFrameqcSurface::EndFrameqcSurface() {
+}
+
+EndFrameqcSurface::EndFrameqcSurface(const std::string& str) : EndFrameqcFoot(str) {
+}
+
+void EndFrameqcSurface::updateFootPoint(FColDsptr rOpO)
+{
+	if (!surface) {
+		return;
+	}
+	auto rmpm = pointInMarker(rOpO);
+	Vec3 p = { rmpm->at(0), rmpm->at(1), rmpm->at(2) };
+	surface->project(p, u, v);
+	setFoot(surface->value(u, v), surface->normal(u, v));
+}
+
+void EndFrameqcSurface::resetFootPoint()
+{
+	u = std::numeric_limits<double>::quiet_NaN();
+	v = std::numeric_limits<double>::quiet_NaN();
+}
