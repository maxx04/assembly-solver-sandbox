+    QPointer<TaskDialog> dialog = foundTaskInfo->ActiveDialog;
+    dialog->setProperty("taskview_accept_or_reject", true);
+    bool success = dialog->accept();
+    if (!dialog) {
+        return;
+    }
+    dialog->setProperty("taskview_accept_or_reject", QVariant());
