diff --git a/src/3rdParty/OndselSolver/OndselSolver/EndFrameqcCurve.cpp b/src/3rdParty/OndselSolver/OndselSolver/EndFrameqcCurve.cpp
new file mode 100644
index 0000000..01e9609
--- /dev/null
+++ b/src/3rdParty/OndselSolver/OndselSolver/EndFrameqcCurve.cpp
@@ -0,0 +1,106 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#include <cmath>
+
+#include "EndFrameqcCurve.h"
+#include "MarkerFrame.h"
+
+using namespace MbD;
+
+namespace {
+	using Vec3 = MbD::NurbsCurve::Vec3;
+
+	double dot(const Vec3& a, const Vec3& b)
+	{
+		return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+	}
+
+	Vec3 cross(const Vec3& a, const Vec3& b)
+	{
+		return { a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0] };
+	}
+
+	bool normalize(Vec3& a)
+	{
+		double len = std::sqrt(dot(a, a));
+		if (len < 1.0e-300) {
+			return false;
+		}
+		for (auto& x : a) {
+			x /= len;
+		}
+		return true;
+	}
+
+	// x axis perpendicular to t, as close as possible to ref (keeps the frame from spinning
+	// around the tangent between iterations).
+	Vec3 perpendicularTo(const Vec3& t, const Vec3& ref)
+	{
+		Vec3 x = ref;
+		double along = dot(x, t);
+		for (size_t i = 0; i < 3; i++) {
+			x[i] -= along * t[i];
+		}
+		if (dot(x, x) < 0.01) {
+			size_t k = 0;
+			for (size_t i = 1; i < 3; i++) {
+				if (std::fabs(t[i]) < std::fabs(t[k])) {
+					k = i;
+				}
+			}
+			x = { 0.0, 0.0, 0.0 };
+			x[k] = 1.0;
+			along = dot(x, t);
+			for (size_t i = 0; i < 3; i++) {
+				x[i] -= along * t[i];
+			}
+		}
+		normalize(x);
+		return x;
+	}
+}
+
+EndFrameqcCurve::EndFrameqcCurve() {
+}
+
+EndFrameqcCurve::EndFrameqcCurve(const std::string& str) : EndFrameqcOffset(str) {
+}
+
+FColDsptr EndFrameqcCurve::pointInMarker(FColDsptr rOpO)
+{
+	auto rmpO = rOpO->minusFullColumn(markerFrame->rOmO);
+	return markerFrame->aAOm->transposeTimesFullColumn(rmpO);
+}
+
+void EndFrameqcCurve::updateFootPoint(FColDsptr rOpO)
+{
+	if (!curve) {
+		return;
+	}
+	auto rmpm = pointInMarker(rOpO);
+	Vec3 p = { rmpm->at(0), rmpm->at(1), rmpm->at(2) };
+	u = curve->project(p, u);
+	Vec3 c, d1, d2;
+	curve->evaluate(u, c, d1, d2);
+	Vec3 t = d1;
+	if (!normalize(t)) {
+		// Degenerate parametrization (zero derivative): keep the previous direction.
+		t = { aAme->at(0)->at(2), aAme->at(1)->at(2), aAme->at(2)->at(2) };
+	}
+	Vec3 x = perpendicularTo(t, refX);
+	refX = x;
+	Vec3 y = cross(t, x);
+	for (size_t i = 0; i < 3; i++) {
+		rmem->at(i) = c[i];
+		aAme->at(i)->at(0) = x[i];
+		aAme->at(i)->at(1) = y[i];
+		aAme->at(i)->at(2) = t[i];
+	}
+	calcPostDynCorrectorIteration();
+}
