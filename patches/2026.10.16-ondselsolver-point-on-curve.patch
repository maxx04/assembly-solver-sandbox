index 0000000..202c96d
--- /dev/null
+++ b/src/3rdParty/OndselSolver/OndselSolver/ASMTPointOnCurveJoint.cpp
@@ -0,0 +1,192 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#include <fstream>
+#include <iomanip>
+#include <limits>
+
+#include "ASMTPointOnCurveJoint.h"
+#include "ASMTAssembly.h"
+#include "ASMTMarker.h"
+#include "EndFrameqcCurve.h"
+#include "MarkerFrame.h"
+#include "PointOnCurveJoint.h"
+#include "SimulationStoppingError.h"
+#include "System.h"
+#include "TranslationLimitIJ.h"
+#include "Units.h"
+
+using namespace MbD;
+
+namespace {
+	// Unit vectors x, y perpendicular to z, columns of aAme = [x y z].
+	void setFrameAlong(FMatDsptr aAme, const NurbsCurve::Vec3& z)
+	{
+		size_t k = 0;
+		for (size_t i = 1; i < 3; i++) {
+			if (std::fabs(z[i]) < std::fabs(z[k])) {
+				k = i;
+			}
+		}
+		NurbsCurve::Vec3 x = { 0.0, 0.0, 0.0 };
+		x[k] = 1.0;
+		double along = x[0] * z[0] + x[1] * z[1] + x[2] * z[2];
+		for (size_t i = 0; i < 3; i++) {
+			x[i] -= along * z[i];
+		}
+		double len = std::sqrt(x[0] * x[0] + x[1] * x[1] + x[2] * x[2]);
+		for (auto& xi : x) {
+			xi /= len;
+		}
+		NurbsCurve::Vec3 y = { z[1] * x[2] - z[2] * x[1], z[2] * x[0] - z[0] * x[2], z[0] * x[1] - z[1] * x[0] };
+		for (size_t i = 0; i < 3; i++) {
+			aAme->at(i)->at(0) = x[i];
+			aAme->at(i)->at(1) = y[i];
+			aAme->at(i)->at(2) = z[i];
+		}
+	}
+
+	void storeOnLevelDoubles(std::ofstream& os, size_t level, const std::vector<double>& values)
+	{
+		for (size_t i = 0; i < level; i++) {
+			os << '\t';
+		}
+		auto oldPrecision = os.precision(std::numeric_limits<double>::max_digits10);
+		for (double value : values) {
+			os << value << '\t';
+		}
+		os << std::endl;
+		os.precision(oldPrecision);
+	}
+}
+
+std::shared_ptr<ASMTPointOnCurveJoint> MbD::ASMTPointOnCurveJoint::With()
+{
+	auto asmt = std::make_shared<ASMTPointOnCurveJoint>();
+	asmt->initialize();
+	return asmt;
+}
+
+std::shared_ptr<ItemIJ> MbD::ASMTPointOnCurveJoint::mbdClassNew()
+{
+	return CREATE<PointOnCurveJoint>::With();
+}
+
+void MbD::ASMTPointOnCurveJoint::setCurve(size_t deg, const std::vector<double>& kts,
+	const std::vector<double>& wts, const std::vector<double>& pls, bool isClosed)
+{
+	degree = deg;
+	knots = kts;
+	weights = wts;
+	poles = pls;
+	closed = isClosed;
+}
+
+void MbD::ASMTPointOnCurveJoint::parseASMT(std::vector<std::string>& lines)
+{
+	ASMTJoint::parseASMT(lines);
+	auto readRow = [&](const std::string& label, std::vector<double>& values) {
+		values.clear();
+		if (!lines.empty() && lines[0].find(label) != std::string::npos) {
+			lines.erase(lines.begin());
+			auto row = readRowOfDoubles(lines[0]);
+			values.assign(row->begin(), row->end());
+			lines.erase(lines.begin());
+		}
+	};
+	if (!lines.empty() && lines[0].find("degree") != std::string::npos) {
+		lines.erase(lines.begin());
+		degree = (size_t)readInt(lines[0]);
+		lines.erase(lines.begin());
+	}
+	if (!lines.empty() && lines[0].find("closed") != std::string::npos) {
+		lines.erase(lines.begin());
+		closed = readBool(lines[0]);
+		lines.erase(lines.begin());
+	}
+	readRow("knots", knots);
+	readRow("weights", weights);
+	readRow("poles", poles);
+}
+
+void MbD::ASMTPointOnCurveJoint::createMbD(std::shared_ptr<System> mbdSys, std::shared_ptr<Units> mbdUnits)
+{
+	std::vector<NurbsCurve::Vec3> curvePoles;
+	for (size_t i = 0; i + 2 < poles.size(); i += 3) {
+		curvePoles.push_back({ poles[i], poles[i + 1], poles[i + 2] });
+	}
+	auto curve = std::make_shared<NurbsCurve>(degree, knots, weights, curvePoles, closed);
+	if (!curve->isValid()) {
+		throw SimulationStoppingError("PointOnCurveJoint " + name + ": invalid curve.");
+	}
+	curve->scale(1.0 / mbdUnits->length);
+
+	ASMTJoint::createMbD(mbdSys, mbdUnits);
+	auto mbdJt = std::static_pointer_cast<PointOnCurveJoint>(mbdObject);
+	auto mrkI = std::static_pointer_cast<EndFramec>(root()->markerAt(markerI)->mbdObject);
+	auto mrkJ = std::static_pointer_cast<EndFramec>(root()->markerAt(markerJ)->mbdObject);
+	auto markerFrameI = mrkI->getMarkerFrame();
+
+	auto curveFrm = CREATE<EndFrameqcCurve>::With();
+	markerFrameI->addEndFrame(curveFrm);
+	curveFrm->curve = curve;
+	mbdJt->connectsItoJ(curveFrm, mrkJ);
+
+	if (curve->isClosed()) {
+		return;
+	}
+	// End stops: at each end the point may not pass the plane through the end point that is
+	// perpendicular to the end tangent ("=>" 0 along the inward tangent).
+	for (int end = 0; end < 2; end++) {
+		double u = end == 0 ? curve->firstParameter() : curve->lastParameter();
+		auto c = curve->value(u);
+		auto t = curve->tangent(u);
+		if (end == 1) {
+			for (auto& ti : t) {
+				ti = -ti;
+			}
+		}
+		auto endFrm = CREATE<EndFrameqcOffset>::With();
+		markerFrameI->addEndFrame(endFrm);
+		for (size_t i = 0; i < 3; i++) {
+			endFrm->rmem->at(i) = c[i];
+		}
+		setFrameAlong(endFrm->aAme, t);
+		auto limit = TranslationLimitIJ::With();
+		limit->name = mbdJt->name + (end == 0 ? "-CurveStart" : "-CurveEnd");
+		limit->connectsItoJ(endFrm, mrkJ);
+		limit->type = "=>";
+		limit->limit = 0.0;
+		limit->tol = 1.0e-9;
+		mbdSys->addLimit(limit);
+	}
+}
+
+void MbD::ASMTPointOnCurveJoint::storeOnLevel(std::ofstream& os, size_t level)
+{
+	// Not ASMTJoint::storeOnLevel(): it derives the type name from typeid().name(), which only
+	// gives the right text with MSVC.
+	storeOnLevelString(os, level, "PointOnCurveJoint");
+	ASMTItemIJ::storeOnLevel(os, level);
+	storeOnLevelString(os, level + 1, "degree");
+	storeOnLevelInt(os, level + 2, (int)degree);
+	storeOnLevelString(os, level + 1, "closed");
+	storeOnLevelBool(os, level + 2, closed);
+	storeOnLevelString(os, level + 1, "knots");
+	storeOnLevelDoubles(os, level + 2, knots);
+	storeOnLevelString(os, level + 1, "weights");
+	storeOnLevelDoubles(os, level + 2, weights);
+	storeOnLevelString(os, level + 1, "poles");
+	storeOnLevelDoubles(os, level + 2, poles);
+}
+
+void MbD::ASMTPointOnCurveJoint::storeOnTimeSeries(std::ofstream& os)
+{
+	os << "PointOnCurveJointSeries\t" << fullName("") << std::endl;
+	ASMTItemIJ::storeOnTimeSeries(os);
+}
