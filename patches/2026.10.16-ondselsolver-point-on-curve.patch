+#pragma once
+
+#include "ASMTJoint.h"
+
+namespace MbD {
+	// Origin of marker J stays on a curve fixed to marker I. The curve is a (rational) B-spline
+	// in the coordinates of marker I. On an open curve the point stops at the curve ends (two
+	// translation limits along the end tangents).
+	class ASMTPointOnCurveJoint : public ASMTJoint
+	{
+		//
+	public:
+		static std::shared_ptr<ASMTPointOnCurveJoint> With();
+		std::shared_ptr<ItemIJ> mbdClassNew() override;
+		void parseASMT(std::vector<std::string>& lines) override;
+		void createMbD(std::shared_ptr<System> mbdSys, std::shared_ptr<Units> mbdUnits) override;
+		void storeOnLevel(std::ofstream& os, size_t level) override;
+		void storeOnTimeSeries(std::ofstream& os) override;
+
+		// poles: x, y, z of each pole one after the other. weights may be empty.
+		void setCurve(size_t degree, const std::vector<double>& knots,
+			const std::vector<double>& weights, const std::vector<double>& poles, bool closed);
+
+		size_t degree = 0;
+		std::vector<double> knots, weights, poles;
+		bool closed = false;
+	};
+}
