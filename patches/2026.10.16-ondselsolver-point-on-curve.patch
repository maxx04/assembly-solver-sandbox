+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#pragma once
+
+#include "EndFrameqc.h"
+
+namespace MbD {
+	// End frame displaced from its marker by a constant offset rmem and rotation aAme
+	// (marker coordinates). Same algebra as EndFrameqct, but without time dependence, so the
+	// q-only constraint classes (isEndFrameqc() == true) can use it.
+	class EndFrameqcOffset : public EndFrameqc
+	{
