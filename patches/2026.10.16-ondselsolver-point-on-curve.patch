+
+#pragma once
+
+#include <limits>
+#include <memory>
+
+#include "EndFrameqcOffset.h"
+#include "NurbsCurve.h"
+
+namespace MbD {
+	// End frame that sits on the curve point closest to a given point, with its z axis along
+	// the curve tangent there. Used by PointOnCurveJoint: "point on the z axis of this frame"
+	// is then "point on the curve" to first order, and the frame is moved to the new foot point
+	// in every iteration.
+	class EndFrameqcCurve : public EndFrameqcOffset
+	{
+		//curve u refX
+	public:
+		EndFrameqcCurve();
+		EndFrameqcCurve(const std::string& str);
+		// rOpO: the point (global coordinates). The marker of this frame must be up to date.
+		void updateFootPoint(FColDsptr rOpO);
+		// Point in the coordinates of this frame's marker.
+		FColDsptr pointInMarker(FColDsptr rOpO);
+
+		std::shared_ptr<NurbsCurve> curve;
+		double u = std::numeric_limits<double>::quiet_NaN();
+		NurbsCurve::Vec3 refX = { 0.0, 0.0, 0.0 };
+	};
+}
diff --git a/src/3rdParty/OndselSolver/OndselSolver/EndFrameqcOffset.cpp b/src/3rdParty/OndselSolver/OndselSolver/EndFrameqcOffset.cpp
