@@ -0,0 +1,62 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#include "EndFrameqcOffset.h"
+#include "MarkerFrame.h"
+#include "EulerParameters.h"
+
+using namespace MbD;
+
+EndFrameqcOffset::EndFrameqcOffset() {
+}
+
+EndFrameqcOffset::EndFrameqcOffset(const std::string& str) : EndFrameqc(str) {
+}
+
+void EndFrameqcOffset::initialize()
+{
+	EndFrameqc::initialize();
+	rmem = std::make_shared<FullColumn<double>>(3, 0.0);
+	aAme = FullMatrix<double>::identitysptr(3);
+}
+
+void EndFrameqcOffset::calcPostDynCorrectorIteration()
+{
+	auto& rOmO = markerFrame->rOmO;
+	auto& aAOm = markerFrame->aAOm;
+	rOeO = rOmO->plusFullColumn(aAOm->timesFullColumn(rmem));
+	auto& prOmOpE = markerFrame->prOmOpE;
+	auto& pAOmpE = markerFrame->pAOmpE;
+	for (size_t i = 0; i < 3; i++)
+	{
+		auto& prOmOpEi = prOmOpE->at(i);
+		auto& prOeOpEi = prOeOpE->at(i);
+		for (size_t j = 0; j < 4; j++)
+		{
+			prOeOpEi->at(j) = prOmOpEi->at(j) + pAOmpE->at(j)->at(i)->timesFullColumn(rmem);
+		}
+	}
+	pprOeOpEpE = EulerParameters<double>::ppApEpEtimesColumn(rpep());
+	aAOe = aAOm->timesFullMatrix(aAme);
+	for (size_t i = 0; i < 4; i++)
+	{
+		pAOepE->at(i) = pAOmpE->at(i)->timesFullMatrix(aAme);
+	}
+	auto aApe = markerFrame->aApm->timesFullMatrix(aAme);
+	ppAOepEpE = EulerParameters<double>::ppApEpEtimesMatrix(aApe);
+}
+
+FColDsptr EndFrameqcOffset::rmeO()
+{
+	return markerFrame->aAOm->timesFullColumn(rmem);
+}
+
+FColDsptr EndFrameqcOffset::rpep()
+{
+	return markerFrame->rpmp->plusFullColumn(markerFrame->aApm->timesFullColumn(rmem));
+}
diff --git a/src/3rdParty/OndselSolver/OndselSolver/EndFrameqcOffset.h b/src/3rdParty/OndselSolver/OndselSolver/EndFrameqcOffset.h
