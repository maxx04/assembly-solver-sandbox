+
+#pragma once
+
+#include <array>
+#include <limits>
+#include <vector>
+
+namespace MbD {
+	// Rational B-spline space curve, used as the path of a PointOnCurveJoint.
+	// The curve is given in the coordinates of the marker it is attached to.
+	class NurbsCurve
+	{
+	public:
+		using Vec3 = std::array<double, 3>;
+
+		// knots is the full (flat) knot vector, size poles.size() + degree + 1.
+		// weights may be empty (non-rational curve).
+		// closed: the parameter wraps around instead of being clamped at the ends.
+		NurbsCurve(size_t degree, std::vector<double> knots, std::vector<double> weights,
+			std::vector<Vec3> poles, bool closed);
+
+		bool isValid() const;
+		bool isClosed() const;
+		double firstParameter() const;
+		double lastParameter() const;
+		// Wraps (closed) or clamps (open) u into [firstParameter, lastParameter].
+		double normalizeParameter(double u) const;
+		void evaluate(double u, Vec3& c, Vec3& d1, Vec3& d2) const;
+		Vec3 value(double u) const;
+		Vec3 tangent(double u) const;
+		// Parameter of the curve point closest to p. Starts a local search at uGuess; with NaN a
+		// coarse sampling of the whole curve gives the start.
+		double project(const Vec3& p, double uGuess = std::numeric_limits<double>::quiet_NaN()) const;
+		void scale(double factor);
+
+		size_t degree;
+		std::vector<double> knots, weights;
+		std::vector<Vec3> poles;
+		bool closed;
+
+	private:
+		size_t findSpan(double u) const;
+		void dersBasisFuns(size_t span, double u, size_t nDerivs, std::vector<std::vector<double>>& ders) const;
+		double sampleStart(const Vec3& p) const;
+	};
+}
