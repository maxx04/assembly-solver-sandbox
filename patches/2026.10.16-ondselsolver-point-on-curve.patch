diff --git a/src/3rdParty/OndselSolver/OndselSolver/NurbsCurve.cpp b/src/3rdParty/OndselSolver/OndselSolver/NurbsCurve.cpp
new file mode 100644
index 0000000..fefb86b
--- /dev/null
+++ b/src/3rdParty/OndselSolver/OndselSolver/NurbsCurve.cpp
@@ -0,0 +1,287 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#include <algorithm>
+#include <cmath>
+
+#include "NurbsCurve.h"
+
+using namespace MbD;
+
+namespace {
+	using Vec3 = MbD::NurbsCurve::Vec3;
+
+	double dot(const Vec3& a, const Vec3& b)
+	{
+		return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+	}
+
+	Vec3 minus(const Vec3& a, const Vec3& b)
+	{
+		return { a[0] - b[0], a[1] - b[1], a[2] - b[2] };
+	}
+
+	double dist2(const Vec3& a, const Vec3& b)
+	{
+		auto d = minus(a, b);
+		return dot(d, d);
+	}
+}
+
+MbD::NurbsCurve::NurbsCurve(size_t deg, std::vector<double> kts, std::vector<double> wts,
+	std::vector<Vec3> pls, bool isClosed) :
+	degree(deg), knots(std::move(kts)), weights(std::move(wts)), poles(std::move(pls)), closed(isClosed)
+{
+	if (weights.empty()) {
+		weights.assign(poles.size(), 1.0);
+	}
+}
+
+bool MbD::NurbsCurve::isValid() const
+{
+	return degree >= 1 && poles.size() > degree && knots.size() == poles.size() + degree + 1
+		&& weights.size() == poles.size() && lastParameter() > firstParameter();
+}
+
+bool MbD::NurbsCurve::isClosed() const
+{
+	return closed;
+}
+
+double MbD::NurbsCurve::firstParameter() const
+{
+	return knots[degree];
+}
+
+double MbD::NurbsCurve::lastParameter() const
+{
+	return knots[poles.size()];
+}
+
+double MbD::NurbsCurve::normalizeParameter(double u) const
+{
+	double a = firstParameter();
+	double b = lastParameter();
+	if (closed) {
+		double period = b - a;
+		u = a + std::fmod(u - a, period);
+		if (u < a) {
+			u += period;
+		}
+		return u;
+	}
+	return std::clamp(u, a, b);
+}
+
+size_t MbD::NurbsCurve::findSpan(double u) const
+{
+	size_t n = poles.size() - 1;
+	if (u >= knots[n + 1]) {
+		return n;
+	}
+	if (u <= knots[degree]) {
+		return degree;
+	}
+	size_t low = degree;
+	size_t high = n + 1;
+	size_t mid = (low + high) / 2;
+	while (u < knots[mid] || u >= knots[mid + 1]) {
+		if (u < knots[mid]) {
+			high = mid;
+		}
+		else {
+			low = mid;
+		}
+		mid = (low + high) / 2;
+	}
+	return mid;
+}
+
+void MbD::NurbsCurve::dersBasisFuns(size_t span, double u, size_t nDerivs,
+	std::vector<std::vector<double>>& ders) const
+{
+	// Piegl/Tiller, The NURBS Book, algorithm A2.3.
+	size_t p = degree;
+	std::vector<std::vector<double>> ndu(p + 1, std::vector<double>(p + 1, 0.0));
+	std::vector<double> left(p + 1, 0.0), right(p + 1, 0.0);
+	ndu[0][0] = 1.0;
+	for (size_t j = 1; j <= p; j++) {
+		left[j] = u - knots[span + 1 - j];
+		right[j] = knots[span + j] - u;
+		double saved = 0.0;
+		for (size_t r = 0; r < j; r++) {
+			ndu[j][r] = right[r + 1] + left[j - r];
+			double temp = ndu[r][j - 1] / ndu[j][r];
+			ndu[r][j] = saved + right[r + 1] * temp;
+			saved = left[j - r] * temp;
+		}
+		ndu[j][j] = saved;
+	}
+	ders.assign(nDerivs + 1, std::vector<double>(p + 1, 0.0));
+	for (size_t j = 0; j <= p; j++) {
+		ders[0][j] = ndu[j][p];
+	}
+	std::vector<std::vector<double>> a(2, std::vector<double>(p + 1, 0.0));
+	for (int r = 0; r <= (int)p; r++) {
+		int s1 = 0;
+		int s2 = 1;
+		a[0][0] = 1.0;
+		for (int k = 1; k <= (int)nDerivs; k++) {
+			double d = 0.0;
+			int rk = r - k;
+			int pk = (int)p - k;
+			if (r >= k) {
+				a[s2][0] = a[s1][0] / ndu[pk + 1][rk];
+				d = a[s2][0] * ndu[rk][pk];
+			}
+			int j1 = (rk >= -1) ? 1 : -rk;
+			int j2 = (r - 1 <= pk) ? k - 1 : (int)p - r;
+			for (int j = j1; j <= j2; j++) {
+				a[s2][j] = (a[s1][j] - a[s1][j - 1]) / ndu[pk + 1][rk + j];
+				d += a[s2][j] * ndu[rk + j][pk];
+			}
+			if (r <= pk) {
+				a[s2][k] = -a[s1][k - 1] / ndu[pk + 1][r];
+				d += a[s2][k] * ndu[r][pk];
+			}
+			ders[k][r] = d;
+			std::swap(s1, s2);
+		}
+	}
+	double factor = (double)p;
+	for (size_t k = 1; k <= nDerivs; k++) {
+		for (size_t j = 0; j <= p; j++) {
+			ders[k][j] *= factor;
+		}
+		factor *= (double)(p - k);
+	}
+}
+
+void MbD::NurbsCurve::evaluate(double u, Vec3& c, Vec3& d1, Vec3& d2) const
+{
+	u = normalizeParameter(u);
+	size_t span = findSpan(u);
+	size_t nDerivs = std::min<size_t>(2, degree);
+	std::vector<std::vector<double>> ders;
+	dersBasisFuns(span, u, nDerivs, ders);
+	// Homogeneous derivatives A(k) = sum N(k) w P and w(k) = sum N(k) w.
+	Vec3 a[3] = { {0, 0, 0}, {0, 0, 0}, {0, 0, 0} };
+	double w[3] = { 0, 0, 0 };
+	for (size_t k = 0; k <= nDerivs; k++) {
+		for (size_t j = 0; j <= degree; j++) {
+			size_t i = span - degree + j;
+			double nw = ders[k][j] * weights[i];
+			for (size_t m = 0; m < 3; m++) {
+				a[k][m] += nw * poles[i][m];
+			}
+			w[k] += nw;
+		}
+	}
+	// Rational derivatives (The NURBS Book, A4.2).
+	for (size_t m = 0; m < 3; m++) {
+		c[m] = a[0][m] / w[0];
+		d1[m] = (a[1][m] - w[1] * c[m]) / w[0];
+		d2[m] = (a[2][m] - 2.0 * w[1] * d1[m] - w[2] * c[m]) / w[0];
+	}
+}
+
+NurbsCurve::Vec3 MbD::NurbsCurve::value(double u) const
+{
+	Vec3 c, d1, d2;
+	evaluate(u, c, d1, d2);
+	return c;
+}
+
+NurbsCurve::Vec3 MbD::NurbsCurve::tangent(double u) const
+{
+	Vec3 c, d1, d2;
+	evaluate(u, c, d1, d2);
+	double len = std::sqrt(dot(d1, d1));
+	if (len > 0.0) {
+		for (auto& x : d1) {
+			x /= len;
+		}
+	}
+	return d1;
+}
+
+double MbD::NurbsCurve::sampleStart(const Vec3& p) const
+{
+	double a = firstParameter();
+	double b = lastParameter();
+	size_t nSamples = std::max<size_t>(200, 20 * poles.size());
+	double best = a;
+	double bestDist2 = std::numeric_limits<double>::max();
+	for (size_t i = 0; i <= nSamples; i++) {
+		double u = a + (b - a) * (double)i / (double)nSamples;
+		double d = dist2(value(u), p);
+		if (d < bestDist2) {
+			bestDist2 = d;
+			best = u;
+		}
+	}
+	return best;
+}
+
+double MbD::NurbsCurve::project(const Vec3& p, double uGuess) const
+{
+	double a = firstParameter();
+	double b = lastParameter();
+	double range = b - a;
+	double u = std::isnan(uGuess) ? sampleStart(p) : normalizeParameter(uGuess);
+	// Newton on f(u) = c'(u) . (c(u) - p) = 0, damped so that the distance never grows.
+	Vec3 c, d1, d2;
+	evaluate(u, c, d1, d2);
+	double currentDist2 = dist2(c, p);
+	for (int iter = 0; iter < 50; iter++) {
+		auto r = minus(c, p);
+		double f = dot(d1, r);
+		double df = dot(d2, r) + dot(d1, d1);
+		if (df <= 0.0) {
+			df = dot(d1, d1);
+		}
+		if (df <= 0.0) {
+			break;
+		}
+		double du = std::clamp(-f / df, -0.25 * range, 0.25 * range);
+		bool improved = false;
+		for (int halving = 0; halving < 20; halving++) {
+			double uNew = normalizeParameter(u + du);
+			Vec3 cNew, d1New, d2New;
+			evaluate(uNew, cNew, d1New, d2New);
+			double newDist2 = dist2(cNew, p);
+			if (newDist2 <= currentDist2) {
+				double step = std::fabs(uNew - u);
+				if (closed && step > 0.5 * range) {
+					step = range - step;
+				}
+				u = uNew;
+				c = cNew;
+				d1 = d1New;
+				d2 = d2New;
+				currentDist2 = newDist2;
+				improved = step > 1.0e-15 * range;
+				break;
+			}
+			du *= 0.5;
+		}
+		if (!improved || std::fabs(du) < 1.0e-14 * range) {
+			break;
+		}
+	}
+	return u;
+}
+
+void MbD::NurbsCurve::scale(double factor)
+{
+	for (auto& pole : poles) {
+		for (auto& x : pole) {
+			x *= factor;
+		}
+	}
+}
