+    void invalidate();
+
+private:
+    void ensureJointEdgesBuilt();
+
+    AssemblyObject* rootAssembly;
+    bool jointEdgesBuilt = false;
+    std::vector<JointEdge> edges;
+
+    bool groundedBuilt = false;
+    std::unordered_set<IdentityHandle, IdentityHandleHash> groundedSet;
+};
