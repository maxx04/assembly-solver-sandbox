+std::string joinContextNames(const std::vector<App::DocumentObject*>& objs)
+{
+    std::string result;
+    for (auto* obj : objs) {
+        if (!obj) {
+            continue;
+        }
+        if (!result.empty()) {
+            result += ", ";
+        }
+        result += getJointContextName(obj);
+    }
+    return result;
+}
