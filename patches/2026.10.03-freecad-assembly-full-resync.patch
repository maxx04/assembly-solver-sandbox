+                if (child->isDerivedFrom<App::Link>() && child->isLinkGroup()) {
+                    auto* link = static_cast<App::Link*>(child);
+                    for (auto* elt : link->ElementList.getValues()) {
+                        if (!isSubAssemblyFullyUnconnected(elt)) {
+                            return false;
+                        }
+                    }
+                    continue;
+                }
+                if (!isSubAssemblyFullyUnconnected(child)) {
