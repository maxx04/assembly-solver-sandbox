+namespace
+{
+int dragDegreesOfFreedom(JointType type)
+{
+    switch (type) {
+        case JointType::Revolute:
+        case JointType::Slider:
+            return 1;
+        case JointType::Cylindrical:
+            return 2;
+        case JointType::Ball:
+            return 3;
+        default:
+            return 6;  // kein eigener Zieh-Modus (Distance, Parallel, ...)
+    }
