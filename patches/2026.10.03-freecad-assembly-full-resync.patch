+App::DocumentObject* findInstanceUnder(
+    App::DocumentObject* sourceContainer,  // AssemblyObject oder Spiegel-AssemblyLink der Quelle
+    AssemblyLink* mirrorContainer,
+    App::DocumentObject* obj,
+    int depth
+)
+{
