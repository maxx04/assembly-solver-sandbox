+void FileDialog::setupSearchFilter()
+{
+    if (searchLineEdit) {
+        return;  // already set up - showEvent() can fire more than once
+    }
+
+    // Only the non-native (Qt-drawn) dialog exposes an internal QGridLayout
+    // we can add a widget to; the native OS dialog is a black box and isn't
+    // affected by this at all. Note this internal UI is itself built lazily
+    // by QFileDialog, only once the dialog is actually about to be shown -
+    // it doesn't exist yet right after construction (verified empirically:
+    // layout() is nullptr there). That's why this runs from showEvent()
+    // instead of the constructor.
+    auto* grid = qobject_cast<QGridLayout*>(layout());
+    if (!grid) {
+        // Some Qt builds/styles wrap the dialog's actual content grid in an
+        // outer layout instead of exposing it directly via layout(). Fall
+        // back to searching the whole widget tree for a QGridLayout -
+        // QLayout is QObject-parented to the dialog widget even when nested
+        // inside another layout, so findChildren() reaches it regardless of
+        // nesting depth. Prefer the one that actually contains the
+        // OK/Cancel button box, since that reliably identifies the dialog's
+        // main content grid rather than some smaller nested one.
+        QDialogButtonBox* buttonBox = findChild<QDialogButtonBox*>();
+        const auto grids = findChildren<QGridLayout*>();
+        for (auto* candidate : grids) {
+            if (buttonBox && candidate->indexOf(buttonBox) >= 0) {
+                grid = candidate;
+                break;
+            }
+        }
+        if (!grid && !grids.isEmpty()) {
+            grid = grids.constFirst();
+        }
+        Base::Console().log(
+            "FileDialog::setupSearchFilter: top-level layout() is %s (not a "
+            "QGridLayout); found %d nested QGridLayout(s), %s.\n",
+            layout() ? layout()->metaObject()->className() : "nullptr",
+            int(grids.size()),
+            grid ? "using one of them" : "none usable - search field not added"
+        );
+    }
+    if (!grid) {
+        return;
+    }
+
+    // Remember what the "Files of type" combo had selected so it can be
+    // restored once the search field is cleared again - onSearchTextChanged()
+    // temporarily overrides it with setNameFilter() while searching.
+    originalNameFilters = nameFilters();
+    originalSelectedFilter = selectedNameFilter();
+
+    auto* label = new QLabel(tr("Search:"), this);
+    auto* edit = new QLineEdit(this);
+    edit->setClearButtonEnabled(true);
+    edit->setPlaceholderText(
+        tr("Filter files in this folder (wildcards * and ? supported)")
+    );
+    connect(edit, &QLineEdit::textChanged, this, &FileDialog::onSearchTextChanged);
+    searchLineEdit = edit;
+
+    // Deliberately appended at grid->rowCount(), i.e. the first row that is
+    // guaranteed to still be empty - this lands below the OK/Cancel button
+    // box rather than above it, but avoids guessing at the internal row/
+    // column position of any existing widget (an earlier version tried to
+    // detect and shift the button box down, which risked landing the new
+    // row on top of already-occupied cells - e.g. if the button box shares
+    // its row with the "File name" controls - and could silently produce an
+    // invisible/overlapped field instead of a visible error).
+    int row = grid->rowCount();
+    grid->addWidget(label, row, 0);
+    grid->addWidget(edit, row, 1, 1, grid->columnCount() - 1);
+
+    Base::Console().log(
+        "FileDialog::setupSearchFilter: search field added at grid row %d.\n",
+        row
+    );
+}
+
+void FileDialog::onSearchTextChanged(const QString& text)
+{
+    QString pattern = text.trimmed();
+    if (pattern.isEmpty()) {
+        // Back to whatever the "Files of type" combo had selected before
+        // searching started.
+        setNameFilters(originalNameFilters);
+        if (!originalSelectedFilter.isEmpty()) {
+            selectNameFilter(originalSelectedFilter);
+        }
+        return;
+    }
+
+    // Plain text without explicit wildcards is treated as a substring match
+    // ("*text*"); a pattern that already contains '*' or '?' is used as-is,
+    // so e.g. "BOM*.csv" keeps working as a real wildcard mask. setNameFilter()
+    // is QFileDialog's own, fully supported filtering mechanism (same one the
+    // "Files of type" combo uses) - unlike a custom proxy model, it needs no
+    // extra bookkeeping to keep folders always navigable: QFileDialog already
+    // never applies name filters to directories, only to files.
+    if (!pattern.contains(QLatin1Char('*')) && !pattern.contains(QLatin1Char('?'))) {
+        pattern = QStringLiteral("*%1*").arg(pattern);
+    }
+    setNameFilter(pattern);
+}
